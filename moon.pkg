// The engines and the writer sit with the tree: MoonBit methods live with
// their type, and a selector engine generic over a trait view of the tree
// would be a second representation of it. `event` is the one dependency,
// because the tree builder is an event stream's consumer.
import {
  "moonbitstack/moonxml/event",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
}
