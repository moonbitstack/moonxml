    "zeta" => Some("\u{03B6}")
    "eta" => Some("\u{03B7}")
    "theta" => Some("\u{03B8}")
    "iota" => Some("\u{03B9}")
    "kappa" => Some("\u{03BA}")
    "lambda" => Some("\u{03BB}")
    "mu" => Some("\u{03BC}")
    "nu" => Some("\u{03BD}")
    "xi" => Some("\u{03BE}")
    "omicron" => Some("\u{03BF}")
    "pi" => Some("\u{03C0}")
    "rho" => Some("\u{03C1}")
    "sigmaf" => Some("\u{03C2}")
    "sigma" => Some("\u{03C3}")
