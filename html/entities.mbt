    "prop" => Some("\u{221D}")
    "infin" => Some("\u{221E}")
    "ang" => Some("\u{2220}")
    "and" => Some("\u{2227}")
    "or" => Some("\u{2228}")
    "cap" => Some("\u{2229}")
    "cup" => Some("\u{222A}")
    "int" => Some("\u{222B}")
    "there4" => Some("\u{2234}")
    "sim" => Some("\u{223C}")
    "cong" => Some("\u{2245}")
    "asymp" => Some("\u{2248}")
    "ne" => Some("\u{2260}")
    "equiv" => Some("\u{2261}")
    "le" => Some("\u{2264}")
