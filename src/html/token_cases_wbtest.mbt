    ("pendingSpecChanges.test", "<!---- >", Data, "", "<!---- >", ["m-- >"]),
    (
      "test1.test",
      "Correct Doctype lowercase",
      Data,
      "",
      "<!DOCTYPE html>",
      ["d=html\u{1F}~\u{1F}~\u{1F}1"],
    ),
    (
      "test1.test",
      "Correct Doctype uppercase",
      Data,
      "",
      "<!DOCTYPE HTML>",
      ["d=html\u{1F}~\u{1F}~\u{1F}1"],
    ),
    (
      "test1.test",
      "Correct Doctype mixed case",
      Data,
      "",
      "<!DOCTYPE HtMl>",
      ["d=html\u{1F}~\u{1F}~\u{1F}1"],
    ),
    (
      "test1.test",
      "Correct Doctype case with EOF",
      Data,
      "",
      "<!DOCTYPE HtMl",
      ["d=html\u{1F}~\u{1F}~\u{1F}0"],
    ),
    ("test1.test", "Truncated doctype start", Data, "", "<!DOC>", ["mDOC"]),
    (
      "test1.test",
      "Doctype in error",
      Data,
      "",
      "<!DOCTYPE foo>",
      ["d=foo\u{1F}~\u{1F}~\u{1F}1"],
    ),
    ("test1.test", "Single Start Tag", Data, "", "<h>", ["sh"]),
    ("test1.test", "Empty end tag", Data, "", "</>", []),
    ("test1.test", "Empty start tag", Data, "", "<>", ["c<>"]),
    (
      "test1.test",
      "Start Tag w/attribute",
      Data,
      "",
      "<h a='b'>",
      ["sh\u{1F}a=b"],
    ),
    (
      "test1.test",
      "Start Tag w/attribute no quotes",
      Data,
      "",
      "<h a=b>",
      ["sh\u{1F}a=b"],
    ),
    ("test1.test", "Start/End Tag", Data, "", "<h></h>", ["sh", "eh"]),
    (
      "test1.test",
      "Two unclosed start tags",
      Data,
      "",
      "<p>One<p>Two",
      ["sp", "cOne", "sp", "cTwo"],
    ),
    (
      "test1.test",
      "End Tag w/attribute",
      Data,
      "",
      "<h></h a='b'>",
      ["sh", "eh"],
    ),
    (
      "test1.test",
      "Multiple atts",
      Data,
