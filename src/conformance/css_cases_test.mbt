    (
      "css3-modsel-139b.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED Attribute space-separated value selector without declared namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\n@namespace html url(http://www.w3.org/1999/xhtml);\n*|p, *|address, *|q, *|r { display : block ; margin-bottom : 1em }\n*|address, *|r { background-color : lime ! important }\ndiv.stub *|*:not([|class~=\"foo\"]) { background-color : red }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body xmlns:b=\"http://www.example.org/b\">\n<div class=\"stub\">\n<p id=\"t1\" class=\"bar foo toto\">This paragraph should be unstyled.</p>\n<address id=\"t2\" class=\"bar foofoo toto\">This address should have a green background.</address>\n<q id=\"t3\" xmlns=\"http://www.example.org/a\" class=\"bar foo toto\">This paragraph should be unstyled.</q>\n<r id=\"t4\" xmlns=\"http://www.example.org/b\" b:class=\"bar foo toto\">This paragraph should have a green background.</r>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_not_background_color('t1', LIME);\n  assert_not_background_color('t1', RED);\n  assert_background_color('t2', LIME);\n  assert_not_background_color('t3', LIME);\n  assert_not_background_color('t3', RED);\n  assert_background_color('t4', LIME);\n}, 'NEGATED Attribute space-separated value selector without declared namespace');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-14.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>More than one class selector</title>\n   <script src=\"/resources/testharness.js\"></script>\n   <script src=\"/resources/testharnessreport.js\"></script>\n  <style type=\"text/css\"><![CDATA[p { background-color : red ; border : thick solid red ; padding : 1em }\np.t1 { background-color : lime }\np.t2 { border : thick solid green }\n\ndiv { background: green; color: white; }\ndiv.teST { background: red; color: yellow; }\ndiv.te { background: red; color: yellow; }\ndiv.st { background: red; color: yellow; }\ndiv.te.st { background: red; color: yellow; }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n\n<p id=\"target1\" class=\"t1 t2\">This paragraph\nshould have a green background and a green thick solid border because\nit carries both classes t1 and t2.</p>\n\n<div id=\"target2\" class=\"test\">This line\nshould be green.</div>\n\n<script><![CDATA[\ntest(function() {\n  const t1 = document.getElementById('target1');\n  assert_equals(getComputedStyle(t1).backgroundColor, 'rgb(0, 255, 0)', 'background-color');\n  assert_equals(getComputedStyle(t1).borderLeftColor, 'rgb(0, 128, 0)', 'border-left-color');\n  assert_equals(getComputedStyle(t1).borderLeftStyle, 'solid', 'border-left-style');\n}, \"p.t1.t2 should have green background and border\");\n\ntest(function() {\n  const t2 = document.getElementById('target2');\n  assert_equals(getComputedStyle(t2).backgroundColor, 'rgb(0, 128, 0)', 'background-color');\n}, \"div.test should have green background\");\n]]></script>\n</body>\n</html>",
    ),
    (
      "css3-modsel-140.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED Attribute dash-separated value selector without declared namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\n@namespace html url(http://www.w3.org/1999/xhtml);\n*|p, *|address, *|q, *|r { display : block ; margin-bottom : 1em }\n*|address, *|r { background-color : red }\ndiv.stub *|*:not([|lang|=\"foo-bar\"]) { background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body xmlns:b=\"http://www.example.org/b\">\n<div class=\"stub\">\n<p id=\"u1\" lang=\"foo-bar\">This paragraph should be unstyled.</p>\n<address id=\"t1\" lang=\"foo-b\">This address should have a green background.</address>\n<address id=\"t2\" lang=\"foo-barbar-toto\">This address should have a green background.</address>\n<q id=\"u2\" xmlns=\"http://www.example.org/a\" lang=\"foo-bar\">This paragraph should be unstyled.</q>\n<r id=\"t3\" xmlns=\"http://www.example.org/b\" b:lang=\"foo-bar\">This paragraph should have a green background.</r>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n  assert_not_background_color('u1', LIME);\n  assert_not_background_color('u2', LIME);\n}, 'NEGATED Attribute dash-separated value selector without declared namespace');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-140b.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED Attribute dash-separated value selector without declared namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\n@namespace html url(http://www.w3.org/1999/xhtml);\n*|p, *|address, *|q, *|r { display : block ; margin-bottom : 1em }\n*|address, *|r { background-color : lime ! important }\ndiv.stub *|*:not([|lang|=\"foo-bar\"]) { background-color : red }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n   <script src=\"/resources/testharness.js\"></script>\n   <script src=\"/resources/testharnessreport.js\"></script>\n   <script src=\"common.js\"></script>\n </head>\n <body xmlns:b=\"http://www.example.org/b\">\n<div class=\"stub\">\n<p id=\"u1\" lang=\"foo-bar\">This paragraph should be unstyled.</p>\n<address id=\"t1\" lang=\"foo-b\">This address should have a green background.</address>\n<address id=\"t2\" lang=\"foo-barbar-toto\">This address should have a green background.</address>\n<q id=\"u2\" xmlns=\"http://www.example.org/a\" lang=\"foo-bar\">This paragraph should be unstyled.</q>\n<r id=\"t3\" xmlns=\"http://www.example.org/b\" b:lang=\"foo-bar\">This paragraph should have a green background.</r>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n  assert_not_background_color('u1', LIME);\n  assert_not_background_color('u2', LIME);\n}, 'NEGATED Attribute dash-separated value selector without declared namespace');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-144.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :enabled:disabled pseudo-classes</title>\n  <style type=\"text/css\"><![CDATA[div :not(:enabled):not(:disabled) { background: lime; }\np { background : red;}]]></style>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <div>\n  <p id=\"t1\">This paragraph should have a green background.</p>\n </div>\n  <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, 'NEGATED :enabled:disabled pseudo-classes');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-145a.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:nth-of-type() pseudo-class with hidden elements</title>\n  <style type=\"text/css\"><![CDATA[\n  line { display: block; }\n  [type~=odd] { background: red; }\n  line:nth-of-type(odd) { background: lime; }\n  [hidden] { display: none; }\n]]></style>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <test xmlns=\"http://www.example.org/\">\n  <line id=\"t1\" type=\"odd\">This line should be green.</line>\n  <line id=\"u1\" type=\"even\">This line should be unstyled.</line>\n  <line id=\"t2\" type=\"odd\" hidden=\"hidden\">This line should be green.</line>\n  <line id=\"u2\" type=\"even\">This line should be unstyled.</line>\n  <line id=\"t3\" type=\"odd\">This line should be green.</line>\n  <line id=\"u3\" type=\"even\">This line should be unstyled.</line>\n  <line id=\"t4\" type=\"odd\">This line should be green.</line>\n  <line id=\"u4\" type=\"even\" hidden=\"hidden\">This line should be unstyled.</line>\n  <line id=\"t5\" type=\"odd\">This line should be green.</line>\n  <line id=\"u5\" type=\"even\">This line should be unstyled.</line>\n  <line id=\"t6\" type=\"odd\">This line should be green.</line>\n  <line id=\"u6\" type=\"even\" hidden=\"hidden\">This line should be unstyled.</line>\n  <line id=\"t7\" type=\"odd\" hidden=\"hidden\">This line should be green.</line>\n  <line id=\"u7\" type=\"even\">This line should be unstyled.</line>\n  <line id=\"t8\" type=\"odd\">This line should be green.</line>\n </test>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n  assert_background_color('t4', LIME);\n  assert_background_color('t5', LIME);\n  assert_background_color('t6', LIME);\n  assert_background_color('t7', LIME);\n  assert_background_color('t8', LIME);\n  assert_not_background_color('u1', LIME);\n  assert_not_background_color('u2', LIME);\n  assert_not_background_color('u3', LIME);\n  assert_not_background_color('u4', LIME);\n  assert_not_background_color('u5', LIME);\n  assert_not_background_color('u6', LIME);\n  assert_not_background_color('u7', LIME);\n}, 'nth-of-type with hidden elements');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-145b.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:nth-of-type() pseudo-class with hidden elements</title>\n  <style type=\"text/css\"><![CDATA[\n  line { display: block; }\n  [type~=odd] { background: lime ! important; }\n  line:nth-of-type(odd) { background: red; }\n  [hidden] { display: none; }\n]]></style>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n  <test xmlns=\"http://www.example.org/\">\n   <line id=\"t1\" type=\"odd\">This line should be green.</line>\n   <line id=\"t2\" type=\"even\">This line should be unstyled.</line>\n   <line id=\"t3\" type=\"odd\" hidden=\"hidden\">This line should be green.</line>\n   <line id=\"t4\" type=\"even\">This line should be unstyled.</line>\n   <line id=\"t5\" type=\"odd\">This line should be green.</line>\n   <line id=\"t6\" type=\"even\">This line should be unstyled.</line>\n   <line id=\"t7\" type=\"odd\">This line should be green.</line>\n   <line id=\"t8\" type=\"even\" hidden=\"hidden\">This line should be unstyled.</line>\n   <line id=\"t9\" type=\"odd\">This line should be green.</line>\n   <line id=\"t10\" type=\"even\">This line should be unstyled.</line>\n   <line id=\"t11\" type=\"odd\">This line should be green.</line>\n   <line id=\"t12\" type=\"even\" hidden=\"hidden\">This line should be unstyled.</line>\n   <line id=\"t13\" type=\"odd\" hidden=\"hidden\">This line should be green.</line>\n   <line id=\"t14\" type=\"even\">This line should be unstyled.</line>\n   <line id=\"t15\" type=\"odd\">This line should be green.</line>\n  </test>\n  <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_not_background_color('t2', RED);\n  assert_background_color('t3', LIME);\n  assert_not_background_color('t4', RED);\n  assert_background_color('t5', LIME);\n  assert_not_background_color('t6', RED);\n  assert_background_color('t7', LIME);\n  assert_not_background_color('t8', RED);\n  assert_background_color('t9', LIME);\n  assert_not_background_color('t10', RED);\n  assert_background_color('t11', LIME);\n  assert_not_background_color('t12', RED);\n  assert_background_color('t13', LIME);\n  assert_not_background_color('t14', RED);\n  assert_background_color('t15', LIME);\n}, 'nth-of-type() counting includes hidden elements');\n]]></script>\n </body>\n</html>\n",
    ),
    (
      "css3-modsel-15.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>ID selectors</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <style type=\"text/css\"><![CDATA[li { background-color : red }\n#t1 { background-color : lime }\nli#t2 { background-color : lime }\nli#t3 { background-color : lime }\n#t4 { background-color : red }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<ul>\n  <li id=\"t1\">This list item should have a green background. because its ID is &quot;t1&quot;</li>\n  <li id=\"t2\">This list item should have a green background. because its ID is &quot;t2&quot;</li>\n  <li id=\"t3\"><span id=\"t44\">This list item should have a green background. because the inner SPAN does not match &quot;#t4&quot;</span></li>\n</ul>\n<script><![CDATA[\ntest(function() {\n  assert_equals(getComputedStyle(document.getElementById('t1')).backgroundColor, 'rgb(0, 255, 0)');\n  assert_equals(getComputedStyle(document.getElementById('t2')).backgroundColor, 'rgb(0, 255, 0)');\n  assert_equals(getComputedStyle(document.getElementById('t3')).backgroundColor, 'rgb(0, 255, 0)');\n}, \"ID selectors match correctly\");\n]]></script>\n</body>\n</html>",
    ),
    (
      "css3-modsel-150.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:empty pseudo-class and XML/SGML constructs</title>\n  <style type=\"text/css\"><![CDATA[\n address:empty { background: lime; }\n address { background: red; margin: 0; height: 1em; }\n .text { margin: -1em 0 0 0; }\n]]></style>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <address id=\"t1\"><!-- --><?test random PI?></address>\n <div class=\"text\">This line should have a green background.</div>\n <p>(Note: This test is based on unpublished errata.)</p>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, ':empty matches elements with only comments and PIs');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-153.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:empty pseudo-class and CDATA</title>\n  <style type=\"text/css\"><![CDATA[\n address { background: red; margin: 0; height: 1em; display: block; }\n address:empty { background: lime; }\n .text { margin: -1em 0 0 0; }\n]]></style>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <address id=\"t1\" xmlns=\"http://tests.example.org/xml-only/\"><![CDATA[]]></address>\n <div class=\"text\">This line should have a green background.</div>\n <p>(Note: This test is based on unpublished errata.)</p>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, 'Empty CDATA section makes the element match :empty');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-161.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Syntax and parsing of unknown pseudo-classes and pseudo-elements</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[\n  p { background: lime; }\n  p   * { background: lime; }\n  p > * { background: lime; }\n  p + * { background: lime; }\n  p ~ * { background: lime; }\n\n  /* let's try some pseudos that are not valid CSS but are likely to\n  be implemented as extensions in some UAs. These should not be\n  recognised, as UAs implementing such extensions should use the\n  :-vnd-ident syntax. */\n\n  :canvas { background: red; }\n  :viewport { background: red; }\n  :window { background: red; }\n  :menu { background: red; }\n  :table { background: red; }\n  :select { background: red; }\n  ::canvas { background: red; }\n  ::viewport { background: red; }\n  ::window { background: red; }\n  ::menu { background: red; }\n  ::table { background: red; }\n  ::select { background: red; }\n]]></style>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n <p id=\"t1\">This line should have a green background.</p>\n <p>\n  UAs may render the following element as a pop up menu. If so, please ensure the menu is unstyled (or green).\n  <select id=\"t2\" size=\"1\">\n   <option>This should</option>\n   <option>have a green</option>\n   <option>background.</option>\n  </select>\n </p>\n <table id=\"t3\"><tr><td>This line should have a green background (or it might be unstyled).</td></tr></table>\n <!-- only allowed to be unstyled if + and ~ are not supported -->\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n}, 'Syntax and parsing of unknown pseudo-classes and pseudo-elements');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-2.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Type element selectors</title>\n  <style type=\"text/css\"><![CDATA[address { background-color: lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<address id=\"t1\">This address element should have a green background.</address>\n<script><![CDATA[\ntest(function() {\n  const t1 = document.getElementById(\"t1\");\n  assert_equals(getComputedStyle(t1).backgroundColor, \"rgb(0, 255, 0)\");\n}, \"address elements should have a green background.\");\n]]></script>\n</body>\n</html>",
    ),
    (
      "css3-modsel-21b.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:target pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[p { background-color: lime; }\np:target { background-color: red; }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n  <p id=\"t1\">This paragraph should be green.</p>\n  <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, 'Paragraph is not target, should be green');\n]]></script>\n </body>\n</html>\n",
    ),
    (
      "css3-modsel-22.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:lang() pseudo-class</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[ul > li { background-color : red }\nli:lang(en-GB) { background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<ul>\n  <li lang=\"en-GB\" id=\"t1\">This list item should be green because its language is\n        British English</li>\n  <li lang=\"en-GB-wa\" id=\"t2\">This list item should be green because its language\n        is British English (Wales)</li>\n</ul>\n<ol>\n  <li lang=\"en-US\" id=\"t3\">This list item should NOT be green because its language\n       is US English</li>\n  <li lang=\"fr\" id=\"t4\">This list item should NOT be green because its language is\n       French</li>\n</ol>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME, 'lang=en-GB should be green');\n  assert_background_color('t2', LIME, 'lang=en-GB-wa should be green');\n  assert_not_background_color('t3', LIME, 'lang=en-US should not be green');\n  assert_not_background_color('t4', LIME, 'lang=fr should not be green');\n}, 'li:lang(en-GB) matches');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-25.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:checked pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[input, span { background-color : red }\ninput:checked, input:checked + span { background-color : lime}\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n<p>\n<input type=\"checkbox\" checked=\"checked\" id=\"t1\"></input> <span id=\"t2\">Everything in this paragraph should have a green background</span></p>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n}, 'checked pseudo-class');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-27.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\" id=\"t1\">\n <head>\n  <title>:root pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[html { background-color : red }\n*:root { background-color: lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <p>The background of the document should be green</p>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, 'The background of the root element should be lime');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-30.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:nth-of-type() pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\np:nth-of-type(3) { background-color : lime }\ndl > :nth-of-type(3n+1) { background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n<p>This paragraph is here only to fill space in the DOM</p>\n<address>And this address too..</address>\n<p>So does this paragraph !</p>\n<p id=\"t1\" class=\"red\">But this one should have green background</p>\n<dl>\n  <dt id=\"t2\" class=\"red\">First definition term that should have green background</dt>\n    <dd id=\"t3\" class=\"red\">First definition that should have green background</dd>\n  <dt>Second definition term</dt>\n    <dd>Second definition</dd>\n  <dt>Third definition term</dt>\n    <dd>Third definition</dd>\n  <dt id=\"t4\" class=\"red\">Fourth definition term that should have green background</dt>\n    <dd id=\"t5\" class=\"red\">Fourth definition that should have green background</dd>\n  <dt>Fifth definition term</dt>\n    <dd>Fifth definition</dd>\n  <dt>Sixth definition term</dt>\n    <dd>Sixth definition</dd>\n</dl>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n  assert_background_color('t4', LIME);\n  assert_background_color('t5', LIME);\n}, 'nth-of-type selector tests');\n]]></script>\n</body>\n</html>",
    ),
    (
      "css3-modsel-32.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:first-child pseudo-class</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\n.t1 td:first-child { background-color : lime }\np > *:first-child { background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<div>\n<table class=\"t1\" border=\"1\">\n  <tr>\n    <td class=\"red\" id=\"t1\">green cell</td>\n    <td>1.2</td>\n    <td>1.3</td>\n  </tr>\n  <tr>\n    <td class=\"red\" id=\"t2\">green cell</td>\n    <td>2.2</td>\n    <td>2.3</td>\n  </tr>\n  <tr>\n    <td class=\"red\" id=\"t3\">green cell</td>\n    <td>3.2</td>\n    <td>3.3</td>\n  </tr>\n</table>\n</div>\n<p>This paragraph contains some text\n          <span id=\"t4\">and a span that should have a green background</span>\n</p>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n  assert_background_color('t4', LIME);\n}, 'CSS Selectors: :first-child');\n]]></script>\n</body>\n</html>",
    ),
    (
      "css3-modsel-33.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:last-child pseudo-class</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\n.t1 td:last-child { background-color : lime }\np > *:last-child { background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<div>\n<table class=\"t1\" border=\"1\">\n  <tr>\n    <td>1.1</td>\n    <td>1.2</td>\n    <td id=\"t1\" class=\"red\">green cell</td>\n  </tr>\n  <tr>\n    <td>2.1</td>\n    <td>2.2</td>\n    <td id=\"t2\" class=\"red\">green cell</td>\n  </tr>\n  <tr>\n    <td>3.1</td>\n    <td>3.2</td>\n    <td id=\"t3\" class=\"red\">green cell</td>\n  </tr>\n</table>\n</div>\n<p>\n<span id=\"t4\">This paragraph contains a span that should\n     have a green background</span> and some text after it.</p>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n  assert_background_color('t4', LIME);\n}, ':last-child');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-34.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:first-of-type pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\naddress { margin-bottom : 1em ; margin-left : 1em }\naddress:first-of-type { background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n<div>This div contains 3 addresses:\n<address id=\"t1\" class=\"red\">A first address that should have a green background</address>\n<address>A second address with normal background</address>\n<address>A third address with normal background</address>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, ':first-of-type');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-35.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:last-of-type pseudo-class</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\naddress { margin-bottom : 1em ; margin-left : 1em }\naddress:last-of-type { background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<div>\n<address id=\"t1\">A first address with normal background</address>\n<address id=\"t2\">A second address with normal background</address>\n<address id=\"t3\" class=\"red\">A third address that should have a green background</address>\nThis div contains 3 addresses above this sentence.</div>\n<script><![CDATA[\ntest(function() {\n  assert_not_background_color('t1', LIME);\n  assert_not_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n}, ':last-of-type');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-36.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:only-child pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\np:only-child { background-color : lime }\ndiv.testText > div > p { margin-left : 1em }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n<p>This paragraph should have normal background</p>\n<div>This div contains only one paragraph\n    <p id=\"t1\" class=\"red\">This paragraph should have green background</p>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, ':only-child matching');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-37.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>:only-of-type pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\n.t1 :only-of-type { background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n<div class=\"t1\">\n<p>This paragraph should have normal background</p>\n<address class=\"red\" id=\"t1\">But this address should have green background</address>\n<p>This paragraph should have normal background</p>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, ':only-of-type');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-4.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Omitted universal selector</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <style type=\"text/css\"><![CDATA[#foo { background-color : lime }\np { background-color : red }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<p id=\"foo\">This paragraph should have a green background</p>\n<script><![CDATA[\ntest(function() {\n  const foo = document.getElementById(\"foo\");\n  assert_equals(getComputedStyle(foo).backgroundColor, \"rgb(0, 255, 0)\");\n}, \"Omitted universal selector\");\n]]></script>\n</body>\n</html>",
    ),
    (
      "css3-modsel-43.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Descendant combinator</title>\n  <style type=\"text/css\"><![CDATA[.white { background-color: transparent ! important; }\n.red { background-color: red; }\ndiv.t1 p { background-color: lime; }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <div class=\"t1\">\n  <p id=\"t1\" class=\"red\">This paragraph should have a green background</p>\n  <table>\n   <tbody>\n    <tr>\n     <td>\n      <p id=\"t2\" class=\"red\">This paragraph should have a green background</p>\n     </td>\n    </tr>\n   </tbody>\n  </table>\n </div>\n <table>\n  <tbody>\n   <tr>\n    <td>\n     <p class=\"white\">This paragraph should be unstyled.</p>\n    </td>\n   </tr>\n  </tbody>\n </table>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n}, 'Descendant combinator');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-43b.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Descendant combinator</title>\n  <style type=\"text/css\"><![CDATA[.white { background-color: transparent ! important; }\n.green { background-color: lime; }\ndiv.t1 p { background-color: red; }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <div class=\"t1\">\n  <p id=\"t1\" class=\"white\">This paragraph should be unstyled</p>\n  <table>\n   <tbody>\n    <tr>\n     <td>\n      <p id=\"t2\" class=\"white\">This paragraph should be unstyled</p>\n     </td>\n    </tr>\n   </tbody>\n  </table>\n </div>\n <table>\n  <tbody>\n   <tr>\n    <td>\n     <p id=\"t3\" class=\"green\">This paragraph should have a green background</p>\n    </td>\n   </tr>\n  </tbody>\n </table>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', 'rgba(0, 0, 0, 0)');\n  assert_background_color('t2', 'rgba(0, 0, 0, 0)');\n  assert_background_color('t3', LIME);\n}, 'Descendant combinator');\n]]></script>\n </body>\n</html>\n",
    ),
    (
      "css3-modsel-44.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Child combinator</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[.white { background-color: transparent ! important; }\n.red { background-color: red; }\ndiv > p.test { background-color: lime; }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n <div>\n  <p id=\"t1\" class=\"red test\">This paragraph should have a green background</p>\n  <div>\n   <p id=\"t2\" class=\"red test\">This paragraph should have a green background</p>\n  </div>\n </div>\n <table>\n  <tbody>\n   <tr>\n    <td>\n     <p id=\"t3\" class=\"white test\">This paragraph should be unstyled.</p>\n    </td>\n   </tr>\n  </tbody>\n </table>\n  <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_not_background_color('t3', LIME);\n}, 'Child combinator');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-44b.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Child combinator</title>\n  <style type=\"text/css\"><![CDATA[.white { background-color: transparent ! important; }\n.green { background-color: lime; }\ndiv > p.test { background-color: red; }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <div>\n  <p class=\"white test\">This paragraph should be unstyled.</p>\n  <div>\n   <p class=\"white test\">This paragraph should be unstyled.</p>\n  </div>\n </div>\n <table>\n  <tbody>\n   <tr>\n    <td>\n     <p id=\"t1\" class=\"green test\">This paragraph should have a green background.</p>\n    </td>\n   </tr>\n  </tbody>\n </table>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, 'Child combinator');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-45.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Direct adjacent combinator</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\ndiv.stub > p + p { background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n <div class=\"stub\">\n  <p>This paragraph should be unstyled.</p>\n  <p class=\"red\" id=\"t1\">But this one should have a green background.</p>\n  <p class=\"red\" id=\"t2\">And this one should also have a green background.</p>\n  <address>This address is only here to fill some space between two paragraphs.</address>\n  <p>This paragraph should be unstyled.</p>\n </div>\n <script><![CDATA[\ntest(function() {\n assert_background_color('t1', LIME);\n assert_background_color('t2', LIME);\n}, 'Direct adjacent combinator');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-45b.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Direct adjacent combinator</title>\n  <style type=\"text/css\"><![CDATA[.green { background-color: lime; }\n.white { background-color: transparent ! important; }\ndiv.stub > p + p { background-color: red; }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <div class=\"stub\">\n  <p class=\"green\" id=\"t1\">This paragraph should have a green background.</p>\n  <p class=\"white\" id=\"t2\">But this one should be unstyled.</p>\n  <p class=\"white\" id=\"t3\">And this one should also be unstyled.</p>\n  <address class=\"green\" id=\"t4\">This address is only here to fill some space between two paragraphs and should have a green background.</address>\n  <p class=\"green\" id=\"t5\">This paragraph should have a green background too.</p>\n </div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', 'rgba(0, 0, 0, 0)');\n  assert_background_color('t3', 'rgba(0, 0, 0, 0)');\n  assert_background_color('t4', LIME);\n  assert_background_color('t5', LIME);\n}, 'Direct adjacent combinator');\n]]></script>\n </body>\n</html>\n",
    ),
    (
      "css3-modsel-45c.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Direct adjacent combinator and classes</title>\n  <style type=\"text/css\"><![CDATA[\n  .fail + div { background: red; }\n  .control { background: lime; }\n]]></style>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n  <div id=\"t2\"> This should be unstyled. </div>\n  <div class=\"control\" id=\"t1\"> This should have a green background. </div>\n  <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME, 't1 should have lime background');\n  assert_not_background_color('t2', RED, 't2 should not have red background');\n}, 'Direct adjacent combinator and classes');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-46.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Indirect adjacent combinator</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\ndiv.stub > p ~ p { background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n <div class=\"stub\">\n  <p>This paragraph should be unstyled.</p>\n  <p class=\"red\" id=\"t1\">But this one should have a green background</p>\n  <p class=\"red\" id=\"t2\">And this one should also have a green background</p>\n  <address>This address is only here to fill some space between two paragraphs</address>\n <p class=\"red\" id=\"t3\">This paragraph should have a green background</p>\n </div>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n}, 'Indirect adjacent combinator');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-46b.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Indirect adjacent combinator</title>\n  <style type=\"text/css\"><![CDATA[.green { background-color : lime ! important }\ndiv.stub > p ~ p { background-color : red }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <div class=\"stub\">\n  <p id=\"first\">This paragraph should be unstyled.</p>\n  <p class=\"green\" id=\"t1\">But this one should have a green background</p>\n  <p class=\"green\" id=\"t2\">And this one should also have a green background</p>\n  <address>This address is only here to fill some space between two paragraphs</address>\n  <p class=\"green\" id=\"t3\">This paragraph should have a green background</p>\n </div>\n  <script><![CDATA[\ntest(function() {\n  assert_not_background_color('first', RED, 'First paragraph should not be red');\n  assert_background_color('t1', LIME, 'Second paragraph should be green');\n  assert_background_color('t2', LIME, 'Third paragraph should be green');\n  assert_background_color('t3', LIME, 'Fourth paragraph should be green');\n}, 'Indirect adjacent combinator');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-47.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED type element selector</title>\n  <style type=\"text/css\"><![CDATA[div.stub span, div.stub address, div.stub *|q, div.stub *|r { background-color: red; }\naddress, *|q, *|r { display: block; margin: 1em; }\ndiv.stub *:not(p) { background-color: lime; }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <div class=\"stub\">\n  <p>\n   <span id=\"t1\">The text in this paragraph should have a green background</span>\n  </p>\n  <address id=\"t2\">This address should have a green background</address>\n  <q id=\"t3\" xmlns=\"http://www.example.org/a\">This element in another namespace should have a green background.</q>\n  <r id=\"t4\" xmlns=\"\">This element without a namespace should have a green background.</r>\n  <p id=\"t5\">This paragraph should be unstyled.</p>\n </div>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME, 'span should be green');\n  assert_background_color('t2', LIME, 'address should be green');\n  assert_background_color('t3', LIME, 'q should be green');\n  assert_background_color('t4', LIME, 'r should be green');\n  assert_not_background_color('t5', LIME, 'p should not be green');\n}, 'NEGATED type element selector');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-5.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Attribute existence selector</title>\n  <style type=\"text/css\"><![CDATA[p { background-color : red }\np[title] { background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n </head>\n <body>\n  <p id=\"t1\" title=\"title\">This paragraph should have a green background because its TITLE attribute is set.</p>\n  <script><![CDATA[\ntest(function() {\n  assert_equals(getComputedStyle(document.getElementById('t1')).backgroundColor, 'rgb(0, 255, 0)');\n}, \"Attribute existence selector\");\n]]></script>\n </body>\n</html>",
    ),
    (
      "css3-modsel-57.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED Attribute existence selector with declared namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\n*|p, *|q, *|r { display : block ; margin-bottom : 1em }\n*|p, *|r { background-color : red }\ndiv.stub *:not([a|title]) {background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body xmlns:a=\"http://www.example.org/a\" xmlns:b=\"http://www.example.org/b\">\n <div class=\"stub\">\n  <q id=\"t3\" xmlns=\"http://www.example.org/a\" a:title=\"a paragraph\">This a:q element should be unstyled.</q>\n  <p id=\"t1\" title=\"a paragraph\">This paragraph should have a green background.</p>\n  <r id=\"t2\" xmlns=\"http://www.example.org/b\" b:title=\"a paragraph\">This b:r element should have a green background.</r>\n </div>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_not_background_color('t3', LIME);\n}, 'NEGATED Attribute existence selector with declared namespace');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-57b.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED Attribute existence selector with declared namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\n*|p, *|q, *|r { display : block ; margin-bottom : 1em }\n*|p, *|r { background-color : lime ! important }\ndiv.stub *:not([a|title]) {background-color : red }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body xmlns:a=\"http://www.example.org/a\" xmlns:b=\"http://www.example.org/b\">\n <div class=\"stub\">\n  <q id=\"t0\" xmlns=\"http://www.example.org/a\" a:title=\"a paragraph\">This a:q element should be unstyled.</q>\n  <p id=\"t1\" title=\"a paragraph\">This paragraph should have a green background.</p>\n  <r id=\"t2\" xmlns=\"http://www.example.org/b\" b:title=\"a paragraph\">This b:r element should have a green background.</r>\n </div>\n  <script><![CDATA[\ntest(function() {\n  assert_not_background_color('t0', RED);\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n}, 'NEGATED Attribute existence selector with declared namespace');\n]]></script>\n </body>\n</html>\n",
    ),
    (
      "css3-modsel-6.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Attribute value selector</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <style type=\"text/css\"><![CDATA[address { background-color : red }\naddress[title=\"foo\"] { background-color : lime }\nspan[title=\"a\"] { background-color : red }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<address title=\"foo\" id=\"t1\">\n<span title=\"b\">This line should </span>\n  <span title=\"aa\">have a green background.\n</span>\n</address>\n<script><![CDATA[\ntest(function() {\n  const t1 = document.getElementById(\"t1\");\n  assert_equals(getComputedStyle(t1).backgroundColor, \"rgb(0, 255, 0)\");\n}, \"address[title=foo] should be lime\");\n]]></script>\n</body>\n</html>",
    ),
    (
      "css3-modsel-7.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Attribute multivalue selector</title>\n  <style type=\"text/css\"><![CDATA[p { background-color : red }\np[class~=\"b\"] { background-color : lime }\naddress { background-color : red }\naddress[title~=\"foo\"] { background-color : lime }\nspan[class~=\"b\"] { background-color : red }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n </head>\n <body>\n<p id=\"t1\" class=\"a b c\">This paragraph should have green background because CLASS\n  contains &quot;b&quot;</p>\n<address id=\"t2\" title=\"tot foo bar\">\n<span class=\"a c\">This address should also</span>\n  <span class=\"a bb c\">have green background because the selector in the last\n    rule does not apply to the inner SPANs.</span>\n</address>\n<script><![CDATA[\ntest(function() {\n  assert_equals(getComputedStyle(document.getElementById('t1')).backgroundColor, 'rgb(0, 255, 0)');\n  assert_equals(getComputedStyle(document.getElementById('t2')).backgroundColor, 'rgb(0, 255, 0)');\n}, \"Attribute multivalue selector\");\n]]></script>\n</body>\n</html>",
    ),
    (
      "css3-modsel-70.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :checked pseudo-class</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[input, span { background-color : red }\ninput:not(:checked), input:not(:checked) + span { background-color : lime}]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<p>\n<input id=\"t1\" type=\"checkbox\"></input> <span id=\"t2\">Everything in this paragraph should have a green background</span></p>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME, \"input should be green\");\n  assert_background_color('t2', LIME, \"span should be green\");\n}, 'NEGATED :checked pseudo-class');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-72.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :root pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[p:not(:root) { background-color: lime; }\ndiv * { background-color: red; }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <div>\n  <p id=\"t1\">This paragraph should have a green background and there should be no red anywhere.</p>\n </div>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, 'NEGATED :root pseudo-class');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-72b.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :root pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[html:not(:root), test:not(:root) { background-color: red; }\np { background-color: lime; }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <div>\n  <p id=\"t1\">This paragraph should have a green background and there should be no red anywhere.</p>\n </div>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME, 'p should be green');\n  assert_not_background_color(document.documentElement, RED, 'html should not be red');\n}, 'NEGATED :root pseudo-class');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-75.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :nth-of-type() pseudo-class</title>\n   <script src=\"/resources/testharness.js\"></script>\n   <script src=\"/resources/testharnessreport.js\"></script>\n   <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\np:not(:nth-of-type(3)) { background-color : lime }\ndl > *:not(:nth-of-type(3n+1)) { background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<p class=\"red\" id=\"t1\">This paragraph should have green background</p>\n<address>And this address should be unstyled.</address>\n<p class=\"red\" id=\"t2\">This paragraph should also have green background!</p>\n<p>But this one should be unstyled again.</p>\n<dl>\n  <dt>First definition term</dt>\n    <dd>First definition</dd>\n  <dt class=\"red\" id=\"t3\">Second definition term that should have green background</dt>\n    <dd class=\"red\" id=\"t4\">Second definition that should have green background</dd>\n  <dt class=\"red\" id=\"t5\">Third definition term that should have green background</dt>\n    <dd class=\"red\" id=\"t6\">Third definition that should have green background</dd>\n  <dt>Fourth definition term</dt>\n    <dd>Fourth definition</dd>\n  <dt class=\"red\" id=\"t7\">Fifth definition term that should have green background</dt>\n    <dd class=\"red\" id=\"t8\">Fifth definition that should have green background</dd>\n  <dt class=\"red\" id=\"t9\">Sixth definition term that should have green background</dt>\n    <dd class=\"red\" id=\"t10\">Sixth definition that should have green background</dd>\n</dl>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n  assert_background_color('t4', LIME);\n  assert_background_color('t5', LIME);\n  assert_background_color('t6', LIME);\n  assert_background_color('t7', LIME);\n  assert_background_color('t8', LIME);\n  assert_background_color('t9', LIME);\n  assert_background_color('t10', LIME);\n}, \"NEGATED :nth-of-type() pseudo-class\");\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-77.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :first-child pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\n.t1 td:not(:first-child) { background-color : lime }\np > *:not(:first-child) { background-color : lime }\ntable.t1 td { border : thin black solid }\n]]></style>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n <div>\n  <table class=\"t1\" border=\"1\">\n   <tr>\n    <td id=\"f1\">1.1</td>\n    <td id=\"t1\" class=\"red\">green cell</td>\n    <td id=\"t2\" class=\"red\">green cell</td>\n   </tr>\n   <tr>\n    <td id=\"f2\">2.1</td>\n    <td id=\"t3\" class=\"red\">green cell</td>\n    <td id=\"t4\" class=\"red\">green cell</td>\n   </tr>\n   <tr>\n    <td id=\"f3\">3.1</td>\n    <td id=\"t5\" class=\"red\">green cell</td>\n    <td id=\"t6\" class=\"red\">green cell</td>\n   </tr>\n </table>\n </div>\n <p>This paragraph <span id=\"f4\">should be</span> unstyled.</p>\n  <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n  assert_background_color('t4', LIME);\n  assert_background_color('t5', LIME);\n  assert_background_color('t6', LIME);\n\n  // :first-child elements should not be lime\n  assert_not_background_color('f1', LIME);\n  assert_not_background_color('f2', LIME);\n  assert_not_background_color('f3', LIME);\n\n  // span should not be lime\n  assert_not_background_color('f4', LIME);\n}, \"NEGATED :first-child pseudo-class\");\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-78.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :last-child pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\n.t1 td:not(:last-child) { background-color : lime }\np > *:not(:last-child) { background-color : lime }\ntable.t1 td { border : thin black solid }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <div>\n  <table class=\"t1\" border=\"1\">\n   <tr>\n    <td id=\"t1\" class=\"red\">green cell</td>\n    <td id=\"t2\" class=\"red\">green cell</td>\n    <td id=\"t1_3\">1.3</td>\n   </tr>\n   <tr>\n    <td id=\"t3\" class=\"red\">green cell</td>\n    <td id=\"t4\" class=\"red\">green cell</td>\n    <td>2.3</td>\n   </tr>\n   <tr>\n    <td id=\"t5\" class=\"red\">green cell</td>\n    <td id=\"t6\" class=\"red\">green cell</td>\n    <td>3.3</td>\n   </tr>\n  </table>\n </div>\n <p>This <span id=\"s1\">paragraph should</span> be unstyled.</p>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n  assert_background_color('t4', LIME);\n  assert_background_color('t5', LIME);\n  assert_background_color('t6', LIME);\n  assert_not_background_color('t1_3', LIME);\n  assert_not_background_color('s1', LIME);\n}, \"NEGATED :last-child pseudo-class\");\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-78b.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :last-child pseudo-class</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[.green { background-color : lime ! important }\n.t1 td:not(:last-child) { background-color : red }\np > *:not(:last-child) { background-color : red }\ntable.t1 td { border : thin black solid }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n <div>\n  <table class=\"t1\" border=\"1\">\n   <tr>\n    <td id=\"t1\" class=\"green\">green cell</td>\n    <td id=\"t2\" class=\"green\">green cell</td>\n    <td id=\"t1_3\">1.3</td>\n   </tr>\n   <tr>\n    <td id=\"t3\" class=\"green\">green cell</td>\n    <td id=\"t4\" class=\"green\">green cell</td>\n    <td id=\"t2_3\">2.3</td>\n   </tr>\n   <tr>\n    <td id=\"t5\" class=\"green\">green cell</td>\n    <td id=\"t6\" class=\"green\">green cell</td>\n    <td id=\"t3_3\">3.3</td>\n   </tr>\n  </table>\n </div>\n <p>This <span id=\"t7\">paragraph should</span> be unstyled.</p>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n  assert_background_color('t4', LIME);\n  assert_background_color('t5', LIME);\n  assert_background_color('t6', LIME);\n  assert_not_background_color('t1_3', RED);\n  assert_not_background_color('t2_3', RED);\n  assert_not_background_color('t3_3', RED);\n  assert_not_background_color('t7', RED);\n}, \"NEGATED :last-child pseudo-class\");\n]]></script>\n </body>\n</html>",
    ),
    (
      "css3-modsel-79.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :first-of-type pseudo-class</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\naddress { margin-bottom : 1em ; margin-left : 1em }\naddress:not(:first-of-type) { background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<div>This div contains 3 addresses :\n<address>A first address with normal background</address>\n<address id=\"t1\" class=\"red\">A second address that should have a green background</address>\n<address id=\"t2\" class=\"red\">A third address that should have a green background</address>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n}, \"NEGATED :first-of-type pseudo-class\");\n]]></script>\n</body>\n</html>",
    ),
    (
      "css3-modsel-8.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Attribute value selectors (hyphen-separated attributes)</title>\n  <style type=\"text/css\"><![CDATA[p { background-color : red }\np[lang|=\"en\"] { background-color : lime }\naddress { background-color : red }\naddress[lang=\"fi\"] { background-color : lime }\nspan[lang|=\"fr\"] { background-color : red }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n </head>\n <body>\n<p id=\"t1\" lang=\"en-gb\">This paragraph should have green background because its language is &quot;en-gb&quot;</p>\n<address id=\"t2\" lang=\"fi\">\n<span id=\"t3\" lang=\"en-us\">This address should also</span>\n  <span id=\"t4\" lang=\"en-fr\">have green background because the language of the inner SPANs\n     is not French.</span>\n</address>\n<script><![CDATA[\ntest(function() {\n  assert_equals(getComputedStyle(document.getElementById('t1')).backgroundColor, 'rgb(0, 255, 0)');\n  assert_equals(getComputedStyle(document.getElementById('t2')).backgroundColor, 'rgb(0, 255, 0)');\n  assert_not_equals(getComputedStyle(document.getElementById('t3')).backgroundColor, 'rgb(255, 0, 0)');\n  assert_not_equals(getComputedStyle(document.getElementById('t4')).backgroundColor, 'rgb(255, 0, 0)');\n}, \"Attribute value selectors\");\n]]></script>\n</body>\n</html>",
    ),
    (
      "css3-modsel-80.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :last-of-type pseudo-class</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\naddress { margin-bottom : 1em ; margin-left : 1em }\naddress:not(:last-of-type) { background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<div>\n<address id=\"t1\" class=\"red\">A first address that should have a green background</address>\n<address id=\"t2\" class=\"red\">A second address that should have a green background</address>\n<address id=\"u1\">A third address with normal background</address>\nThis div should have three addresses above it.</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_not_background_color('u1', LIME);\n}, 'NEGATED :last-of-type pseudo-class');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-81.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :only-child pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\np:not(:only-child) { background-color : lime }\ndiv.testText > div > p { margin-left : 1em }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n <p class=\"red\" id=\"t1\">This paragraph should have a green background.</p>\n <div>This div contains only one paragraph.\n  <p id=\"t2\">This paragraph should be unstyled.</p>\n </div>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_not_background_color('t2', LIME);\n}, 'NEGATED :only-child pseudo-class');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-81b.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :only-child pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[.green { background-color : lime ! important }\np:not(:only-child) { background-color : lime }\ndiv.testText > div > p { margin-left : 1em }\n]]></style>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n <p id=\"t1\" class=\"green\">This paragraph should have a green background.</p>\n <div>This div contains only one paragraph.\n  <p id=\"t2\">This paragraph should be unstyled.</p>\n </div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_not_background_color('t2', LIME);\n}, 'NEGATED :only-child pseudo-class');\n]]></script>\n </body>\n</html>\n",
    ),
    (
      "css3-modsel-82.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :only-of-type pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[.red { background-color : red }\n.t1 *:not(:only-of-type) { background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n<div class=\"t1\">\n<p id=\"t1\" class=\"red\">This paragraph should have green background.</p>\n<address id=\"t3\">But this address should be unstyled.</address>\n<p id=\"t2\" class=\"red\">This paragraph should have green background.</p>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_not_background_color('t3', LIME);\n}, 'NEGATED :only-of-type pseudo-class');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-82b.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED :only-of-type pseudo-class</title>\n  <style type=\"text/css\"><![CDATA[.green { background-color : lime ! important }\n.t1 *:not(:only-of-type) { background-color : red }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n<div class=\"t1\">\n<p id=\"t1\" class=\"green\">This paragraph should have green background.</p>\n<address id=\"u1\">But this address should be unstyled.</address>\n<p id=\"t2\" class=\"green\">This paragraph should have green background.</p>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_not_background_color('u1', LIME);\n}, 'NEGATED :only-of-type pseudo-class');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-9.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Substring matching attribute selector (beginning)</title>\n  <style type=\"text/css\"><![CDATA[p { background-color : red }\np[title^=\"foo\"] { background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n </head>\n <body>\n<p id=\"t1\" title=\"foobar\">This paragraph should have a green background<br></br>\nbecause its title attribute begins with &quot;foo&quot;</p>\n <script><![CDATA[\ntest(function() {\n  assert_equals(getComputedStyle(document.getElementById(\"t1\")).backgroundColor, \"rgb(0, 255, 0)\");\n}, \"Substring matching attribute selector (beginning)\");\n]]></script>\n</body>\n</html>",
    ),
    (
      "css3-modsel-91.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Type element selector with declared namespace</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[@namespace test url(http://www.example.org/a);\ntesta { background-color : red }\ntest|testa { background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n </head>\n <body>\n<testa id=\"t1\" xmlns=\"http://www.example.org/a\">This paragraph should have a green background</testa>\n  <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, 'Type element selector with declared namespace');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-92.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Type element selector with universal namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace test url(http://www.example.org/b);\ndiv.myTest * { background-color : red }\ndiv.myTest *|testA { background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n<div class=\"myTest\">\n<testA id=\"t1\" xmlns=\"http://www.example.org/b\">This paragraph should have a green background</testA>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, 'Type element selector with universal namespace');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-93.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Type element selector without declared namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace test url(http://www.example.org/b);\n*|testA { background-color : red }\n|testA {background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n<testA xmlns=\"\" id=\"t1\">This paragraph has no declared namespace and should have a green background.</testA>\n  <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n}, 'Type element selector without declared namespace');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-94.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Universal selector with declared namespace</title>\n   <script src=\"/resources/testharness.js\"></script>\n   <script src=\"/resources/testharnessreport.js\"></script>\n   <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\np, q { display : block ; margin-bottom : 1em }\nb|* { background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n </head>\n <body>\n<p>This line should be unstyled.</p>\n<p id=\"t1\" xmlns=\"http://www.example.org/b\">This line should have a green background.</p>\n<q id=\"t2\" xmlns=\"http://www.example.org/b\">This line should have a green background.</q>\n<p xmlns=\"http://www.example.org/a\">This line should be unstyleed.</p>\n<p id=\"t3\" xmlns=\"http://www.example.org/b\">This line should have a green background.</p>\n  <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n}, 'Universal selector with declared namespace');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-94b.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Universal selector with declared namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\np, q { display : block ; margin-bottom : 1em }\nb|* { background-color : red }\n[test] { background-color: lime; }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body>\n<p id=\"t4\">This line should be unstyled.</p>\n<p xmlns=\"http://www.example.org/b\" test=\"test\" id=\"t1\">This line should have a green background.</p>\n<q xmlns=\"http://www.example.org/b\" test=\"test\" id=\"t2\">This line should have a green background.</q>\n<p xmlns=\"http://www.example.org/a\" id=\"t5\">This line should be unstyled.</p>\n<p xmlns=\"http://www.example.org/b\" test=\"test\" id=\"t3\">This line should have a green background.</p>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME, \"t1 should be green\");\n  assert_background_color('t2', LIME, \"t2 should be green\");\n  assert_background_color('t3', LIME, \"t3 should be green\");\n  assert_not_background_color('t4', RED, \"t4 should not be red\");\n  assert_not_background_color('t5', RED, \"t5 should not be red\");\n}, 'Universal selector with declared namespace');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-95.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Universal selector with universal namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\ndiv.test * { background-color : red ; display : block ; margin-bottom : 1em }\ndiv.test *|* { background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n <script src=\"/resources/testharness.js\"></script>\n   <script src=\"/resources/testharnessreport.js\"></script>\n   <script src=\"common.js\"></script>\n  </head>\n <body>\n  <div class=\"test\">\n   <p id=\"t1\">This line should  have a green background</p>\n   <p id=\"t2\" xmlns=\"http://www.example.org/b\">This line should have a green background</p>\n   <q id=\"t3\" xmlns=\"http://www.example.org/b\">This line should have a green background</q>\n   <p id=\"t4\" xmlns=\"http://www.example.org/a\">This line should have a green background</p>\n   <foo id=\"t5\" xmlns=\"http://www.example.org/b\">This line should have a green background</foo>\n  </div>\n  <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n  assert_background_color('t4', LIME);\n  assert_background_color('t5', LIME);\n}, 'Universal selector with universal namespace');\n]]></script>\n </body>\n</html>\n",
    ),
    (
      "css3-modsel-96.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Universal selector without declared namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\ndiv.green * { background-color : red }\ndiv.test * { display : block ; margin-bottom : 1em }\ndiv.test |* { background-color : lime }]]></style>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n </head>\n <body>\n<div class=\"test\">\n <p>This line should be unstyled.</p>\n <elementA xmlns=\"http://www.example.org/a\">This line should be unstyled.</elementA>\n <elementB xmlns=\"http://www.example.org/b\">This line should be unstyled.</elementB>\n <div class=\"green\">\n  <p xmlns=\"\" id=\"t1\">This line should have a green background</p>\n  <elementA xmlns=\"\" id=\"t2\">This line should have a green background</elementA>\n  <elementB xmlns=\"\" id=\"t3\">This line should have a green background</elementB>\n </div>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_background_color('t3', LIME);\n}, 'Universal selector without declared namespace');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-97.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Attribute existence selector with declared namespace</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\n*|p, *|q, *|r { display : block ; margin-bottom : 1em }\n*|q { background-color : red }\n*[a|title] {background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n </head>\n <body xmlns:a=\"http://www.example.org/a\" xmlns:b=\"http://www.example.org/b\">\n <p id=\"u1\" title=\"a paragraph\">This paragraph should be unstyled.</p>\n <q id=\"t1\" xmlns=\"http://www.example.org/a\" a:title=\"a paragraph\">This paragraph should have a green background.</q>\n <r id=\"u2\" xmlns=\"http://www.example.org/b\" b:title=\"a paragraph\">This paragraph should be unstyled.</r>\n  <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_not_background_color('u1', LIME);\n  assert_not_background_color('u2', LIME);\n}, 'Attribute existence selector with declared namespace');\n]]></script>\n </body>\n</html>\n",
    ),
    (
      "css3-modsel-97b.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Attribute existence selector with declared namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\n*|p, *|q, *|r { display : block ; margin-bottom : 1em }\n*|q { background-color : lime ! important }\n*[a|title] {background-color : red }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body xmlns:a=\"http://www.example.org/a\" xmlns:b=\"http://www.example.org/b\">\n  <p id=\"t1\" title=\"a paragraph\">This paragraph should be unstyled.</p>\n  <q id=\"t2\" xmlns=\"http://www.example.org/a\" a:title=\"a paragraph\">This paragraph should have a green background.</q>\n  <r id=\"t3\" xmlns=\"http://www.example.org/b\" b:title=\"a paragraph\">This paragraph should be unstyled.</r>\n  <script><![CDATA[\ntest(function() {\n  assert_not_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_not_background_color('t3', LIME);\n}, 'Attribute existence selector with declared namespace');\n]]></script>\n </body>\n</html>\n",
    ),
    (
      "css3-modsel-98.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Attribute value selector with declared namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\n*|p, *|q, *|r, *|s { display : block ; margin-bottom : 1em }\n*|q, *|t { background-color : red }\n*[a|title=\"foo\"] {background-color : lime }\n*[a|title=footwo] {background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body xmlns:a=\"http://www.example.org/a\" xmlns:b=\"http://www.example.org/b\">\n  <p id=\"u1\" title=\"foo\">This paragraph should be unstyled.</p>\n  <q id=\"t1\" xmlns=\"http://www.example.org/a\" a:title=\"foo\">This paragraph should have a green background</q>\n  <s id=\"u2\" xmlns=\"http://www.example.org/a\" a:title=\"foobar\">This paragraph should be unstyled.</s>\n  <r id=\"u3\" xmlns=\"http://www.example.org/b\" b:title=\"foo\">This paragraph should be unstyled.</r>\n  <t id=\"t2\" xmlns=\"http://www.example.org/a\" a:title=\"footwo\">This paragraph should have a green background</t>\n  <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_background_color('t2', LIME);\n  assert_not_background_color('u1', LIME);\n  assert_not_background_color('u2', LIME);\n  assert_not_background_color('u3', LIME);\n}, 'Attribute value selector with declared namespace');\n]]></script>\n </body>\n</html>\n",
    ),
    (
      "css3-modsel-98b.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Attribute value selector with declared namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\n*|p, *|q, *|r, *|s { display : block ; margin-bottom : 1em }\n*|q { background-color : lime ! important }\n*[a|title=\"foo\"] {background-color : red }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body xmlns:a=\"http://www.example.org/a\" xmlns:b=\"http://www.example.org/b\">\n <p id=\"u1\" title=\"foo\">This paragraph should be unstyled.</p>\n <q id=\"t1\" xmlns=\"http://www.example.org/a\" a:title=\"foo\">This paragraph should have a green background</q>\n <s id=\"u2\" xmlns=\"http://www.example.org/a\" a:title=\"foobar\">This paragraph should be unstyled.</s>\n <r id=\"u3\" xmlns=\"http://www.example.org/b\" b:title=\"foo\">This paragraph should be unstyled.</r>\n <script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_not_background_color('u1', LIME);\n  assert_not_background_color('u2', LIME);\n  assert_not_background_color('u3', LIME);\n}, 'Attribute value selector with declared namespace');\n]]></script>\n</body>\n</html>\n",
    ),
  ]
}

