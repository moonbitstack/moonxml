      "css3-modsel-10.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Substring matching attribute selector (end)</title>\n  <style type=\"text/css\"><![CDATA[p { background-color : red }\np[title$=\"bar\"] { background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n </head>\n <body>\n<p id=\"t1\" title=\"foobar\">This paragraph should have a green background because\nits title attribute ends with &quot;bar&quot;</p>\n<script><![CDATA[\ntest(function() {\n  const t1 = document.getElementById(\"t1\");\n  assert_equals(getComputedStyle(t1).backgroundColor, \"rgb(0, 255, 0)\");\n}, \"Substring matching attribute selector (end)\");\n]]></script>\n</body>\n</html>",
