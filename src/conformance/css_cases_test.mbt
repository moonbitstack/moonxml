    (
      "css3-modsel-124b.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED Attribute value selector with declared namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\n*|p, *|q, *|r, *|s { display : block ; margin-bottom : 1em }\n*|p, *|r, *|s { background-color : lime ! important }\ndiv.stub *:not([a|title=\"foo\"]) {background-color : red }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body xmlns:a=\"http://www.example.org/a\" xmlns:b=\"http://www.example.org/b\">\n<div class=\"stub\">\n<p id=\"t1\" title=\"foo\">This paragraph should have a green background.</p>\n<q id=\"t2\" xmlns=\"http://www.example.org/a\" a:title=\"foo\">This paragraph should be unstyled.</q>\n<s id=\"t3\" xmlns=\"http://www.example.org/a\" a:title=\"foobar\">This paragraph should have a green background.</s>\n<r id=\"t4\" xmlns=\"http://www.example.org/b\" b:title=\"foo\">This paragraph should have a green background.</r>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_not_background_color('t2', LIME);\n  assert_not_background_color('t2', RED);\n  assert_background_color('t3', LIME);\n  assert_background_color('t4', LIME);\n}, 'NEGATED Attribute value selector with declared namespace');\n]]></script>\n</body>\n</html>\n",
    ),
    (
      "css3-modsel-13.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Class selectors</title>\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <style type=\"text/css\"><![CDATA[li { background-color : red }\n.t1 { background-color : lime }\nli.t2 { background-color : lime }\n.t3 { background-color : red }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n </head>\n <body>\n<ul>\n  <li class=\"t1\" id=\"t1\">This list item should have green background because its class is &quot;t1&quot;</li>\n  <li class=\"t2\" id=\"t2\">This list item should have green background because its class is &quot;t2&quot;</li>\n  <li class=\"t2\" id=\"t3\">\n<span class=\"t33\">This list item should have green background because\n        the inner SPAN does not match SPAN.t3</span>\n</li>\n</ul>\n  <script><![CDATA[\ntest(function() {\n  assert_equals(getComputedStyle(document.getElementById(\"t1\")).backgroundColor, \"rgb(0, 255, 0)\");\n  assert_equals(getComputedStyle(document.getElementById(\"t2\")).backgroundColor, \"rgb(0, 255, 0)\");\n  assert_equals(getComputedStyle(document.getElementById(\"t3\")).backgroundColor, \"rgb(0, 255, 0)\");\n}, \"Class selectors\");\n]]></script>\n</body>\n</html>",
    ),
    (
      "css3-modsel-130.xml", "<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>NEGATED Attribute existence selector with universal namespace</title>\n  <style type=\"text/css\"><![CDATA[@namespace a url(http://www.example.org/a);\n@namespace b url(http://www.example.org/b);\n@namespace html url(http://www.w3.org/1999/xhtml);\n*|p, *|q, *|r, *|s { display : block ; margin-bottom : 1em }\n*|q { background-color : red }\ndiv.stub *|*:not([*|title]) { background-color : lime }\n]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"author\" title=\"Ian Hickson\" href=\"mailto:ian@hixie.ch\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <meta name=\"flags\" content=\" namespace\" />\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n  <script src=\"common.js\"></script>\n </head>\n <body xmlns:a=\"http://www.example.org/a\" xmlns:b=\"http://www.example.org/b\">\n<div class=\"stub\">\n<q id=\"t1\" xmlns=\"http://www.example.org/a\" a:foo=\"si on chantait\">This paragraph should have a green background.</q>\n<r id=\"u1\" xmlns=\"http://www.example.org/a\" a:title=\"si on chantait\">This paragraph should be unstyled.</r>\n<s id=\"u2\" xmlns=\"http://www.example.org/b\" b:title=\"si on chantait\">This paragraph should be unstyled.</s>\n</div>\n<script><![CDATA[\ntest(function() {\n  assert_background_color('t1', LIME);\n  assert_not_background_color('u1', LIME);\n  assert_not_background_color('u1', RED);\n  assert_not_background_color('u2', LIME);\n  assert_not_background_color('u1', RED);\n}, 'NEGATED Attribute existence selector with universal namespace');\n]]></script>\n</body>\n</html>\n",
