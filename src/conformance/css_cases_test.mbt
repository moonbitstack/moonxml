      "css3-modsel-1.xml", "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n <head>\n  <title>Groups of selectors</title>\n  <style type=\"text/css\"><![CDATA[li,p { background-color : lime }]]></style>\n  <link rel=\"author\" title=\"Daniel Glazman\" href=\"http://glazman.org/\"/>\n  <link rel=\"help\" href=\"https://www.w3.org/TR/css3-selectors/#selectors\"/> <!-- bogus link to make sure it gets found -->\n  <script src=\"/resources/testharness.js\"></script>\n  <script src=\"/resources/testharnessreport.js\"></script>\n </head>\n <body>\n<ul>\n  <li id=\"t1\">The background of this list item should be green</li>\n  <li id=\"t2\">The background of this second list item should be also green</li>\n</ul>\n<p id=\"t3\">The background of this paragraph should be green.</p>\n<script><![CDATA[\ntest(function() {\n  assert_equals(getComputedStyle(document.getElementById('t1')).backgroundColor, \"rgb(0, 255, 0)\", \"First li should be lime\");\n  assert_equals(getComputedStyle(document.getElementById('t2')).backgroundColor, \"rgb(0, 255, 0)\", \"Second li should be lime\");\n  assert_equals(getComputedStyle(document.getElementById('t3')).backgroundColor, \"rgb(0, 255, 0)\", \"Paragraph should be lime\");\n}, \"Groups of selectors\");\n]]></script>\n</body>\n</html>",
    ),
