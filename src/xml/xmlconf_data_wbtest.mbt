  (
    "ibm/valid/P36/ibm36v01.xml", "pass", "<!DOCTYPE book [\r\n   <!ELEMENT book ANY>\r\n   <!ATTLIST book xml:lang CDATA #REQUIRED>\r\n]>\r\n<book xml:lang=\"i-BS-ABCD\">It is written in English</book>\r\n",
