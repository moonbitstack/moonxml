  ),
  (
    "sun/invalid/optional05.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-a></once-or-twice-a>\n</root>\n\n",
  ),
  (
    "sun/invalid/optional06.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-b></once-or-twice-b>\n</root>\n\n\n",
  ),
  (
    "sun/invalid/optional07.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-c></once-or-twice-c>\n</root>\n\n\n",
  ),
  (
    "sun/invalid/optional08.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-d></once-or-twice-d>\n</root>\n\n\n",
  ),
  (
    "sun/invalid/optional09.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-e></once-or-twice-e>\n</root>\n\n\n",
  ),
  (
    "sun/invalid/optional10.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-a><e/><e/><e/></once-or-twice-a>\n</root>\n\n\n",
  ),
  (
    "sun/invalid/optional11.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-b><e/><e/><e/></once-or-twice-b>\n</root>\n\n\n\n",
  ),
  (
    "sun/invalid/optional12.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-c><e/><e/><e/></once-or-twice-c>\n</root>\n\n\n\n",
  ),
  (
    "sun/invalid/optional13.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-d><e/><e/><e/></once-or-twice-d>\n</root>\n\n\n\n",
  ),
  (
    "sun/invalid/optional14.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-e><e/><e/><e/></once-or-twice-e>\n</root>\n\n\n\n",
  ),
  (
    "sun/invalid/optional20.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-a></once-or-twice-a>\n</root>\n",
  ),
  (
    "sun/invalid/optional21.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-b></once-or-twice-b>\n</root>\n\n",
  ),
  (
    "sun/invalid/optional22.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-c></once-or-twice-c>\n</root>\n\n",
  ),
  (
    "sun/invalid/optional23.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-d></once-or-twice-d>\n</root>\n\n",
  ),
  (
    "sun/invalid/optional24.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-e></once-or-twice-e>\n</root>\n\n",
  ),
  (
    "sun/invalid/optional25.xml", "pass", "<!DOCTYPE root SYSTEM \"../valid/dtdtest.dtd\">\n<root>\n    <once-or-twice-e>No text allowed!</once-or-twice-e>\n</root>\n\n",
  ),
  (
    "sun/invalid/required00.xml", "pass", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n    <!ATTLIST root\n\treq CDATA #REQUIRED\n\t>\n]>\n\n<root/>\n\n<!-- doesn't include required 'req' attribute -->\n",
  ),
  (
    "sun/invalid/required01.xml", "pass", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n]>\n\n<root xml:space='preserve'/>\n\n    <!-- all attributes must be declared -->\n",
  ),
  (
    "sun/invalid/required02.xml", "pass", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n]>\n\n<root xml:lang='en'/>\n\n    <!-- all attributes must be declared -->\n\n",
  ),
  (
    "sun/invalid/root.xml", "pass", "<?xml version='1.0' standalone='yes'?>\n\n<!DOCTYPE attributes SYSTEM \"../valid/sa.dtd\">\n\n<!-- the name in the dtd must match the element type of the root element -->\n    \n<root/>\n",
  ),
  (
    "sun/invalid/attr01.xml", "pass", "<!DOCTYPE root [\n<!ELEMENT root EMPTY>\n<!ATTLIST root\n    affiliated\tENTITY\t#REQUIRED\n    >\n    <!-- tests the \"entity name\" VC ... the \"entity declared\" clause,\n\tas applied to attributes of type ENTITY -->\n]>\n<root affiliated=\"food\"/>\n",
  ),
  (
    "sun/invalid/attr02.xml", "pass", "<!DOCTYPE root [\n<!ELEMENT root EMPTY>\n<!ATTLIST root\n    affiliated\tENTITIES\t#REQUIRED\n    >\n    <!-- tests the \"entity name\" VC ... the \"entity declared\" clause,\n\tas applied to attributes of type ENTITIES -->\n<!NOTATION fruit\n    PUBLIC \"-//International Grocery Consortium//Edible//Healthy//EN\">\n<!ENTITY apple SYSTEM \"http://www.apple.com\" NDATA fruit>\n]>\n<root affiliated=\"apple apple food\"/>\n",
  ),
  (
    "sun/invalid/attr03.xml", "pass", "<!DOCTYPE root [\n<!ELEMENT root EMPTY>\n<!ATTLIST root\n    type\tNOTATION\t(fruit | vegetable)\t#REQUIRED\n    >\n<!NOTATION fruit\n    PUBLIC \"-//International Grocery Consortium//Edible//Healthy//EN\">\n<!NOTATION vegetable\n    PUBLIC \"-//International Grocery Consortium//Edible//Yucky//EN\">\n<!NOTATION candy\n    PUBLIC \"-//International Grocery Consortium//Edible//Yummy//EN\">\n\n    <!-- tests the 'must match one of the names included in the\n\tdeclaration' part of the \"Notation Attributes\" VC -->\n]>\n<root type=\"candy\"/>\n\n",
  ),
  (
    "sun/invalid/attr04.xml", "pass", "<!DOCTYPE root [\n<!ELEMENT root EMPTY>\n<!ATTLIST root\n    type\tNOTATION\t(fruit | vegetable)\t#REQUIRED\n    >\n<!NOTATION fruit\n    PUBLIC \"-//International Grocery Consortium//Edible//Healthy//EN\">\n\n    <!-- tests the 'all notation names in the declaration must\n\tbe declared' part of the \"Notation Attributes\" VC -->\n]>\n<root type=\"fruit\"/>\n",
  ),
  (
    "sun/invalid/attr05.xml", "pass", "<!DOCTYPE root [\n<!ELEMENT root EMPTY>\n<!ATTLIST root\n    token\tNMTOKEN\t\t#REQUIRED\n    >\n\n    <!-- tests the \"name token' VC for an NMTOKEN value -->\n]>\n<root token=\"dev@null\"/>\n",
  ),
  (
    "sun/invalid/attr06.xml", "pass", "<!DOCTYPE root [\n<!ELEMENT root EMPTY>\n<!ATTLIST root\n    token\tNMTOKEN\t\t#REQUIRED\n    >\n\n    <!-- tests the \"name token' VC for an NMTOKENS value -->\n]>\n<root token=\"now is the time!?\"/>\n",
  ),
  (
    "sun/invalid/attr07.xml", "pass", "<!DOCTYPE arbor [\n<!ELEMENT arbor EMPTY>\n<!ATTLIST arbor\n    type\t(fruit | vegetable)\t\"fruit\"\n    >\n    <!-- tests the 'must match one of the nmtokens included in the\n\tdeclaration' part of the \"Enumeration\" VC -->\n]>\n<arbor type=\"money\"/>\n\n",
  ),
  (
    "sun/invalid/attr08.xml", "pass", "<!DOCTYPE palimpest [\n<!ELEMENT palimpest EMPTY>\n<!ATTLIST palimpest\n    xmlns CDATA #FIXED \"http://java.sun.com/historical\"\n    >\n    <!-- tests the \"fixed attribute default\" vc -->\n]>\n\n<palimpest xmlns=\"http://over.the.rainbow.com/somewhere\"/>\n",
  ),
  (
    "sun/invalid/attr09.xml", "pass", "<!DOCTYPE collection [\n\n<!ELEMENT collection ANY>\n\n<!ELEMENT identifier EMPTY>\n<!ATTLIST identifier\n    value\tIDREF\t\"42\"\n    >\n    <!-- tests the \"attribute default legal\" vc -->\n\n<!ELEMENT identified EMPTY>\n<!ATTLIST identified\n    id\t\tID\t#REQUIRED\n    >\n]>\n\n<collection>\n    <identifier name=\"i-am-not-a-number\"/>\n    <identified id=\"i-am-not-a-number\"/>\n</collection>\n",
  ),
  (
    "sun/invalid/attr10.xml", "pass", "<!DOCTYPE collection [\n\n<!ELEMENT collection ANY>\n\n<!ELEMENT identifier EMPTY>\n<!ATTLIST identifier\n    value\tIDREFS\t\"i-am-not-a-number 42\"\n    >\n    <!-- tests the \"attribute default legal\" vc -->\n\n<!ELEMENT identified EMPTY>\n<!ATTLIST identified\n    id\t\tID\t#REQUIRED\n    >\n]>\n\n<collection>\n    <identifier name=\"i-am-not-a-number\"/>\n    <identified id=\"i-am-not-a-number\"/>\n</collection>\n",
  ),
  (
    "sun/invalid/attr11.xml", "pass", "<!DOCTYPE reference [\r\n\r\n<!ELEMENT reference EMPTY>\r\n<!ATTLIST reference\r\n    value\tENTITY\t\"2orldbook\"\r\n    >\r\n    <!-- tests the \"attribute default legal\" vc -->\r\n\r\n<!NOTATION encyclopaedia PUBLIC \"-//fooCorp Inc//NOTATION something//EN\">\r\n<!ENTITY brittannica SYSTEM \"http://www.eb.com/\" NDATA encyclopaedia>\r\n<!ENTITY worldbook SYSTEM \"http://www.worldbook.com\">\r\n\r\n]>\r\n\r\n<reference value=\"brittannica\"/>\r\n",
  ),
  (
    "sun/invalid/attr12.xml", "pass", "<!DOCTYPE references [\r\n\r\n<!ELEMENT references EMPTY>\r\n<!ATTLIST references\r\n    value\tENTITIES\t\"brittannica 2orldbook\"\r\n    >\r\n    <!-- tests the \"attribute default legal\" vc -->\r\n\r\n<!NOTATION encyclopaedia PUBLIC \"-//fooCorp Inc//NOTATION something//EN\">\r\n<!ENTITY brittannica SYSTEM \"http://www.eb.com/\" NDATA encyclopaedia>\r\n<!ENTITY worldbook SYSTEM \"http://www.worldbook.com\">\r\n\r\n]>\r\n\r\n<references value=\"brittannica\"/>\r\n",
  ),
  (
    "sun/invalid/attr13.xml", "pass", "<!DOCTYPE root [\n\n<!ELEMENT root EMPTY>\n<!ATTLIST root\n    value\tNMTOKEN\t\"alpha/beta\"\n    >\n    <!-- tests the \"attribute default legal\" vc -->\n]>\n\n<root value=\"brittannica\"/>\n\n",
  ),
  (
    "sun/invalid/attr14.xml", "pass", "<!DOCTYPE root [\n\n<!ELEMENT root EMPTY>\n<!ATTLIST root\n    value\tNMTOKENS\t\"alpha beta $gamma\"\n    >\n    <!-- tests the \"attribute default legal\" vc -->\n]>\n\n<root value=\"zeta eta iota\"/>\n\n\n",
  ),
  (
    "sun/invalid/attr15.xml", "pass", "<!DOCTYPE reference [\n\n<!ELEMENT reference EMPTY>\n<!ATTLIST reference\n    source\tNOTATION\t(brittannica | worldbook) \"encarta\"\n    >\n    <!-- tests the \"attribute default legal\" vc -->\n\n<!NOTATION brittannica SYSTEM \"http://www.eb.com/\">\n<!NOTATION worldbook SYSTEM \"http://www.worldbook.com\">\n\n]>\n\n<reference source=\"brittannica\"/>\n",
  ),
  (
    "sun/invalid/attr16.xml", "pass", "<!DOCTYPE root [\n\n<!ELEMENT root EMPTY>\n<!ATTLIST root\n    value\t(brittannica | worldbook) \"encarta\"\n    >\n    <!-- tests the \"attribute default legal\" vc -->\n]>\n\n<root value=\"brittannica\"/>\n",
  ),
  (
    "sun/invalid/empty.xml", "pass", "<!--\r\n    From: \"Henry S. Thompson\" <ht@cogsci.ed.ac.uk>\r\n\r\n    I'd be interested in reports from validating parsers wrt the\r\n    following:\r\n-->\r\n\r\n<!DOCTYPE foo [\r\n<!ELEMENT foo (a+)>\r\n<!ENTITY empty ''>\r\n<!ENTITY space ' '>\r\n<!ELEMENT a EMPTY>]>\r\n<foo>\r\n&empty;\r\n<a/>\r\n&space;\r\n<a/>\r\n<![CDATA[]]>\r\n<a/>\r\n<![CDATA[ ]]>\r\n<a/>\r\n</foo>\r\n",
  ),
  (
    "sun/not-wf/not-sa03.xml", "refuse", "<?xml version='1.0' standalone='yes'?>\n\n<!DOCTYPE attributes SYSTEM \"../valid/sa.dtd\" [\n    <!--\n\tExternal entity ref\n    -->\n]>\n\n<attributes\n    token =\t\"b\"\n    id =\t\"external-&number;\"\n    />\n",
  ),
  (
    "sun/not-wf/attlist01.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- SGML-ism:  illegal attribute types -->\n\n    <!ATTLIST root\n\tnumber\tNUTOKEN\t\"1\"\n\t>\n\n]>\n\n<root/>\n",
  ),
  (
    "sun/not-wf/attlist02.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- SGML-ism:  illegal attribute types -->\n\n    <!ATTLIST root\n\tnumber\tNUTOKENS\t\"1 2 3\"\n\t>\n\n]>\n\n<root/>\n\n",
  ),
  (
    "sun/not-wf/attlist03.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- SGML-ism:  illegal attribute types -->\n\n    <!ATTLIST root\n\tchoice\t(a,b,c)\t\"a\"\n\t>\n\n]>\n\n<root/>\n\n",
  ),
  (
    "sun/not-wf/attlist04.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- SGML-ism:  illegal attribute types -->\n\n    <!ATTLIST root\n\tnumber\tNUMBER\t\"1\"\n\t>\n\n]>\n\n<root/>\n\n",
  ),
  (
    "sun/not-wf/attlist05.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- SGML-ism:  illegal attribute types -->\n\n    <!ATTLIST root\n\tnumbers\tNUMBERS\t\"1 2 3 4\"\n\t>\n\n]>\n\n<root/>\n\n",
  ),
  (
    "sun/not-wf/attlist06.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- SGML-ism:  illegal attribute types -->\n\n    <!ATTLIST root\n\tnumber\tNAME\t\"Elvis\"\n\t>\n\n]>\n\n<root/>\n\n",
  ),
  (
    "sun/not-wf/attlist07.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- SGML-ism:  illegal attribute types -->\n\n    <!ATTLIST root\n\tnumber\tNAMES\t\"The King\"\n\t>\n\n]>\n\n<root/>\n\n",
  ),
  (
    "sun/not-wf/attlist08.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- SGML-ism:  illegal attribute default -->\n\n    <!ATTLIST root\n\tlanguage\tCDATA\t#CURRENT\n\t>\n\n]>\n\n<root/>\n",
  ),
  (
    "sun/not-wf/attlist09.xml", "refuse", "<!DOCTYPE root [\n    <!-- SGML-ism:  illegal attribute default -->\n\n    <!ATTLIST root\n\tlanguage\tCDATA\t#CONREF\n\t>\n\n]>\n\n<root language=\"Dutch\"/>\n\n",
  ),
  (
    "sun/not-wf/attlist10.xml", "refuse", "<!DOCTYPE root [\n<!ELEMENT root ANY>\n<!ATTLIST root att1 CDATA #IMPLIED>\n<!ATTLIST root att2 CDATA #IMPLIED>\n]>\n<root att1=\"value1\"att2=\"value2\">\n    <!-- whitespace required between attributes -->\n</root>\n",
  ),
  (
    "sun/not-wf/attlist11.xml", "refuse", "<!DOCTYPE root [\n<!ELEMENT root ANY>\n<!ATTLIST root att1 CDATA #IMPLIED>\n<!ATTLIST root att2 CDATA #IMPLIED>\n]>\n<root att1=\"value1\"att2=\"value2\"/>\n    <!-- whitespace required between attributes -->\n",
  ),
  (
    "sun/not-wf/content01.xml", "refuse", "<!DOCTYPE root [\n    <!-- no whitespace before '?', '*', '+' -->\n    <!ELEMENT root ((root) ?)>\n]>\n<root/>\n",
  ),
  (
    "sun/not-wf/content02.xml", "refuse", "<!DOCTYPE root [\n    <!-- no whitespace before '?', '*', '+' -->\n    <!ELEMENT root ((root) *)>\n]>\n<root/>\n\n",
  ),
  (
    "sun/not-wf/content03.xml", "refuse", "<!DOCTYPE root [\n    <!-- no whitespace before '?', '*', '+' -->\n    <!ELEMENT root (root +)>\n]>\n<root/>\n\n",
  ),
  (
    "sun/not-wf/dtd00.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root (foo, bar? foo)>\n\t<!-- comma omitted -->\n    <!ELEMENT foo EMPTY>\n    <!ELEMENT bar EMPTY>\n]>\n\n<root> <foo/> <foo/> </root>\n",
  ),
  (
    "sun/not-wf/dtd01.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root (foo, bar? | foo)>\n\t<!-- comma swapped for vertical bar -->\n    <!ELEMENT foo EMPTY>\n    <!ELEMENT bar EMPTY>\n]>\n\n<root> <foo/> <foo/> </root>\n",
  ),
  (
    "sun/not-wf/dtd02.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n    <!-- correct PE ref syntax -->\n    <!ENTITY % foo \"<!ATTLIST root>\">\n    % foo;\n]>\n\n<root/>\n",
  ),
  (
    "sun/not-wf/dtd03.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n    <!-- correct PE ref syntax -->\n    <!ENTITY % foo \"<!ATTLIST root>\">\n    %foo\n    ;\n]>\n\n<root/>\n",
  ),
  (
    "sun/not-wf/dtd04.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n    <!-- PUBLIC id must be quoted -->\n    <!ENTITY foo PUBLIC -//BadCorp//DTD-foo-1.0//EN \"elvis.ent\">\n]>\n\n<root/>\n",
  ),
  (
    "sun/not-wf/dtd05.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n    <!-- SYSTEM id must be quoted -->\n    <!ENTITY foo SYSTEM elvis.ent>\n]>\n\n<root/>\n",
  ),
  (
    "sun/not-wf/element00.xml", "refuse", "<root>\n    Incomplete end tag.\n</ro",
  ),
  (
    "sun/not-wf/element01.xml", "refuse", "<root>\n    Incomplete end tag.\n</root",
  ),
  (
    "sun/not-wf/element02.xml", "refuse", "<!DOCTYPE html [ <!ELEMENT html ANY> ]>\n<html>\n    <% @ LANGUAGE=\"VBSCRIPT\" %>\n</html>\n",
  ),
  (
    "sun/not-wf/element03.xml", "refuse", "<!DOCTYPE html [ <!ELEMENT html ANY> ]>\n<html>\n    <% document.println (\"hello, world\"); %>\n</html>\n\n",
  ),
  (
    "sun/not-wf/element04.xml", "refuse", "<!DOCTYPE root [ <!ELEMENT root ANY> ]>\n<root>\n    <!ELEMENT foo EMPTY>\n</root>\n",
  ),
  (
    "sun/not-wf/encoding01.xml", "refuse", "<?xml version=\"1.0\" encoding=\" utf-8\"?>\n<root/>\n",
  ),
  (
    "sun/not-wf/encoding02.xml", "refuse", "<?xml version=\"1.0\" encoding=\"a/b\"?>\n<root/>\n\n",
  ),
  (
    "sun/not-wf/encoding03.xml", "refuse", "<?xml version=\"1.0\" encoding=\"just&#41;word\"?>\n<root/>\n\n",
  ),
  (
    "sun/not-wf/encoding04.xml", "refuse", "<?xml version=\"1.0\" encoding=\"utf:8\"?>\n<root/>\n\n",
  ),
  (
    "sun/not-wf/encoding05.xml", "refuse", "<?xml version=\"1.0\" encoding=\"@import(sys-encoding)\"?>\n<root/>\n\n",
  ),
  (
    "sun/not-wf/encoding06.xml", "refuse", "<?xml version=\"1.0\" encoding=\"XYZ+999\"?>\n\n<!-- WF ... but illegal encoding name, also a fatal error --> \n\n<root/>\n",
  ),
  (
    "sun/not-wf/pi.xml", "refuse", "<!DOCTYPE root [\n<!ELEMENT root EMPTY>\n<!-- space before PI data and ?> -->\n<?bad-pi+?>\n]>\n<root/>\n",
  ),
  (
    "sun/not-wf/pubid01.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- illegal public ID characters -->\n\n    <!ENTITY e PUBLIC \"this isn&apos;t allowed\" \"ignored\">\n]>\n\n<root/>\n",
  ),
  (
    "sun/not-wf/pubid02.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- illegal public ID characters -->\n\n    <!ENTITY e PUBLIC \"<illegal>\" \"ignored\">\n]>\n\n<root/>\n\n",
  ),
  (
    "sun/not-wf/pubid03.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- illegal public ID characters -->\n\n    <!ENTITY e PUBLIC \"[illegal]\" \"ignored\">\n]>\n\n<root/>\n\n",
  ),
  (
    "sun/not-wf/pubid04.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- illegal public ID characters -->\n\n    <!ENTITY e PUBLIC \"{ illegal }\" \"ignored\">\n]>\n\n<root/>\n\n",
  ),
  (
    "sun/not-wf/pubid05.xml", "refuse", "<!DOCTYPE root [\n\n    <!-- SGML-ism: publid ID without system ID -->\n\n    <!ENTITY e PUBLIC \"this is not allowed\">\n]>\n\n<root/>\n",
  ),
  (
    "sun/not-wf/sgml01.xml", "refuse", "<!DOCTYPE root [\n    <!ELEMENT root EMPTY>\n\n    <!-- SGML-ism:  omitted end tag -->\n]>\n\n<root>\n",
  ),
  (
    "sun/not-wf/sgml02.xml", "refuse", " <?xml version=\"1.0\"?>\n    <!-- SGML-ism:  XML PI not at beginning -->\n<!DOCTYPE root [ <!ELEMENT root EMPTY> ]>\n<root/>\n",
