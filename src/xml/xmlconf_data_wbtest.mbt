  (
    "ibm/valid/P33/ibm33v01.xml", "pass", "<!DOCTYPE book [\r\n   <!ELEMENT book ANY>\r\n   <!ATTLIST book xml:lang CDATA #REQUIRED>\r\n]>\r\n<book xml:lang=\"en-US\">It is written in English</book>\r\n<!-- Tests LanguageID with Langcode - Subcode -->",
