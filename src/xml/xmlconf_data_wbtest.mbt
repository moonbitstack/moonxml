  (
    "eduni/errata-2e/E14.xml", "pass", "<!DOCTYPE foo SYSTEM \"E14.dtd\">\n<foo/>\n",
  ),
  (
    "eduni/errata-2e/E15a.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n<!ENTITY empty \"\">\n]>\n<foo>&empty;</foo>\n\n",
  ),
  (
    "eduni/errata-2e/E15b.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n]>\n<foo><!-- comment --></foo>\n",
  ),
  (
    "eduni/errata-2e/E15c.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n]>\n<foo><?pi xxx?></foo>\n",
  ),
  (
    "eduni/errata-2e/E15d.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n]>\n<foo> </foo>\n",
  ),
  (
    "eduni/errata-2e/E15e.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo (foo*)>\n<!ENTITY space \" \">\n]>\n<foo><foo/>&space;<foo/></foo>\n",
  ),
  (
    "eduni/errata-2e/E15f.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo (foo*)>\n<!ENTITY space \"&#32;\">\n]>\n<foo><foo/>&space;<foo/></foo>\n",
  ),
  (
    "eduni/errata-2e/E15g.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo (foo*)>\n]>\n<foo><foo/>&#32;<foo/></foo>\n",
  ),
  (
    "eduni/errata-2e/E15h.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo (foo*)>\n<!ENTITY space \"&#38;#32;\">\n]>\n<foo><foo/>&space;<foo/></foo>\n",
  ),
  (
    "eduni/errata-2e/E15i.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo (foo*)>\n]>\n<foo><foo/><!-- comment --><foo/></foo>\n",
  ),
  (
    "eduni/errata-2e/E15j.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo (foo*)>\n]>\n<foo><foo/><?pi xxx?><foo/></foo>\n",
  ),
  (
    "eduni/errata-2e/E15k.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo (PCDATA|foo)*>\n]>\n<foo><foo/><!-- comment --><foo/></foo>\n",
  ),
  (
    "eduni/errata-2e/E15l.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo (PCDATA|foo)*>\n]>\n<foo><foo/><?pi xxx?><foo/></foo>\n",
  ),
  (
    "eduni/errata-2e/E18.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ENTITY % pe SYSTEM \"subdir1/E18-pe\">\n%pe;\n%intpe;\n]>\n<foo>&ent;</foo>\n",
  ),
  (
    "eduni/errata-2e/E19.xml", "pass", "<!DOCTYPE foo SYSTEM \"E19.dtd\">\n<foo>&ent;</foo>\n",
  ),
  (
    "eduni/errata-2e/E20.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo bar NMTOKENS #IMPLIED>\n]>\n<foo bar=\"abc&#9;xyz\"/>\n",
  ),
  (
    "eduni/errata-2e/E22.xml", "pass", "﻿<?xml version=\"1.0\"?>\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n]>\n<foo/>\n",
  ),
  (
    "eduni/errata-2e/E24.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ENTITY gt \">\">\n]>\n<foo>You can use ]]&gt; or ]]&#62;</foo>\n",
  ),
  (
    "eduni/errata-2e/E29.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xml:lang NMTOKEN #IMPLIED>\n]>\n<foo xml:lang=\"nds\">\n <foo xml:lang=\"art-lojban\"/>\n</foo>\n",
  ),
  (
    "eduni/errata-2e/E36.xml", "pass", "<?xml version=\"1.0\" standalone=\"yes\"?>\n<!DOCTYPE foo SYSTEM \"E36.dtd\">\n<foo bar=\"123\n456\"/>\n",
  ),
  (
    "eduni/errata-2e/E41.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xml:lang CDATA #IMPLIED>\n]>\n<foo xml:lang=\"\"/>\n",
  ),
  (
    "eduni/errata-2e/E48.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n]>\n<foo>hello</foo>\n",
  ),
  (
    "eduni/errata-2e/E60.xml", "pass", "<?xml version=\"1.0\"?>\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ENTITY % e SYSTEM \"E60.ent\">\n%e;\n]>\n<foo/>\n",
  ),
  (
    "eduni/errata-2e/E61.xml", "refuse", "<?xml version=\"1.0\" encoding=\"UTF-16\"?>\n<root/>\n",
  ),
  (
    "eduni/errata-3e/E05a.xml", "pass", "<!-- CDATA sections may occur in Mixed content. -->\n<!DOCTYPE foo [\n<!ELEMENT foo (#PCDATA|foo)*>\n]>\n<foo>a <![CDATA[cdata section]]> in mixed content</foo>\n",
  ),
  (
    "eduni/errata-3e/E05b.xml", "pass", "<!-- CDATA sections, comments and PIs may occur in ANY content. -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n]>\n<foo>\na <![CDATA[cdata section]]> in mixed content.\na <!-- comment --> in mixed content.\na <?processing instruction?> in mixed content.\n</foo>\n",
  ),
  (
    "eduni/errata-3e/E06a.xml", "pass", "<!-- Default values for IDREF attributes must match Name. -->\n<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n<!ATTLIST foo id ID #IMPLIED>\n<!ATTLIST foo a IDREF \"34\">\n]>\n<foo id=\"g0034\" a=\"g0034\"/>\n",
  ),
  (
    "eduni/errata-3e/E06b.xml", "pass", "<!-- Default values for ENTITY attributes must match Name. -->\n<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n<!ATTLIST foo a ENTITY \"34\">\n<!ENTITY ent SYSTEM \"foo\" NDATA not>\n<!NOTATION not SYSTEM \"not\">\n]>\n<foo a=\"ent\"/>\n",
  ),
  (
    "eduni/errata-3e/E06c.xml", "pass", "<!-- Default values for IDREFS attributes must match Names. -->\n<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n<!ATTLIST foo id ID #IMPLIED>\n<!ATTLIST foo a IDREFS \"34\">\n]>\n<foo id=\"g0034\" a=\"g0034\"/>\n",
  ),
  (
    "eduni/errata-3e/E06d.xml", "pass", "<!-- Default values for ENTITIES attributes must match Names. -->\n<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n<!ATTLIST foo a ENTITIES \"34\">\n<!ENTITY ent SYSTEM \"foo\" NDATA not>\n<!NOTATION not SYSTEM \"not\">\n]>\n<foo a=\"ent\"/>\n",
  ),
  (
    "eduni/errata-3e/E06e.xml", "pass", "<!-- Default values for NMTOKEN attributes must match Nmtoken. -->\n<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n<!ATTLIST foo a NMTOKEN \"34+\">\n]>\n<foo a=\"34\"/>\n",
  ),
  (
    "eduni/errata-3e/E06f.xml", "pass", "<!-- Default values for NMTOKENS attributes must match Nmtokens. -->\n<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n<!ATTLIST foo a NMTOKENS \"34+\">\n]>\n<foo a=\"34\"/>\n",
  ),
  (
    "eduni/errata-3e/E06g.xml", "pass", "<!-- Default values for NOTATION attributes must match one of the enumerated values. -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo a NOTATION (not) \"not2\">\n<!NOTATION not SYSTEM \"not\">\n<!NOTATION not2 SYSTEM \"not2\">\n]>\n<foo a=\"not\">junk</foo>\n",
  ),
  (
    "eduni/errata-3e/E06h.xml", "pass", "<!-- Default values for enumerated attributes must match one of the enumerated values. -->\n<!DOCTYPE foo [\n<!ELEMENT foo EMPTY>\n<!ATTLIST foo a (one|two|three) \"four\">\n]>\n<foo a=\"one\"/>\n",
  ),
  (
    "eduni/errata-3e/E06i.xml", "pass", "<!-- Non-syntactic validity errors in default attributes only happen if the attribute is in fact defaulted. -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo id ID #IMPLIED>\n<!ATTLIST foo ref IDREF \"undef\">\n<!ATTLIST foo ent ENTITY \"undef\">\n<!-- can't test NOTATION attribute, because if it's undeclared then we'll\n     get an error for one of the enumerated values being undeclared. -->\n<!ENTITY ent SYSTEM \"foo\" NDATA not>\n<!NOTATION not SYSTEM \"not\">\n]>\n<foo id=\"g0034\" ref=\"g0034\" ent=\"ent\"/>\n",
  ),
  (
    "eduni/errata-3e/E12.xml", "refuse", "<!-- Default values for attributes may not contain references to external entities. -->\n<!DOCTYPE foo [\n<!ENTITY ent SYSTEM \"ent\">\n<!ELEMENT foo ANY>\n<!ATTLIST foo a CDATA \"contains &ent; reference\">\n]>\n<foo a=\"not defaulted\"/>\n",
  ),
  (
    "eduni/errata-3e/E13.xml", "pass", "<!-- Even internal parameter entity references are enough to make undeclared entities into mere validity errors rather than well-formedness errors. -->\n<!DOCTYPE foo [\n<!ENTITY % pe \"<!ENTITY ent1 'text'>\">\n%pe;\n<!ELEMENT foo ANY>\n]>\n<foo>&ent2;</foo>\n",
  ),
  (
    "eduni/namespaces/1.0/001.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Namespace name test: a perfectly good http URI -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xmlns CDATA #IMPLIED>\n]>\n<foo xmlns=\"http://example.org/namespace\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/002.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Namespace name test: a syntactically plausible URI with a \n     fictitious scheme -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xmlns CDATA #IMPLIED>\n]>\n<foo xmlns=\"zarquon://example.org/namespace\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/003.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Namespace name test: a perfectly good http URI with a fragment -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xmlns CDATA #IMPLIED>\n]>\n<foo xmlns=\"http://example.org/namespace#apples\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/007.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Namespace inequality test: different capitalization -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xmlns:a CDATA #IMPLIED\n              xmlns:b CDATA #IMPLIED\n              xmlns:c CDATA #IMPLIED>\n<!ELEMENT bar ANY>\n<!ATTLIST bar a:attr CDATA #IMPLIED\n              b:attr CDATA #IMPLIED\n              c:attr CDATA #IMPLIED>\n]>\n<foo xmlns:a=\"http://example.org/wine\"\n     xmlns:b=\"http://Example.org/wine\"\n     xmlns:c=\"http://example.org/Wine\">\n\n<bar a:attr=\"1\" b:attr=\"2\" c:attr=\"3\"/>\n\n</foo>\n\n",
  ),
  (
    "eduni/namespaces/1.0/008.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Namespace inequality test: different escaping -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xmlns:a CDATA #IMPLIED\n              xmlns:b CDATA #IMPLIED\n              xmlns:c CDATA #IMPLIED>\n<!ELEMENT bar ANY>\n<!ATTLIST bar a:attr CDATA #IMPLIED\n              b:attr CDATA #IMPLIED\n              c:attr CDATA #IMPLIED>\n]>\n<foo xmlns:a=\"http://example.org/~wilbur\"\n     xmlns:b=\"http://example.org/%7ewilbur\"\n     xmlns:c=\"http://example.org/%7Ewilbur\">\n\n<bar a:attr=\"1\" b:attr=\"2\" c:attr=\"3\"/>\n\n</foo>\n\n",
  ),
  (
    "eduni/namespaces/1.0/009.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Namespace equality test: plain repetition -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xmlns:a CDATA #IMPLIED\n              xmlns:b CDATA #IMPLIED\n              xmlns:c CDATA #IMPLIED>\n<!ELEMENT bar ANY>\n<!ATTLIST bar a:attr CDATA #IMPLIED\n              b:attr CDATA #IMPLIED\n              c:attr CDATA #IMPLIED>\n]>\n<foo xmlns:a=\"http://example.org/~wilbur\"\n     xmlns:b=\"http://example.org/~wilbur\">\n\n<bar a:attr=\"1\" b:attr=\"2\"/>\n\n</foo>\n\n",
  ),
  (
    "eduni/namespaces/1.0/010.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Namespace equality test: use of character reference -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xmlns:a CDATA #IMPLIED\n              xmlns:b CDATA #IMPLIED\n              xmlns:c CDATA #IMPLIED>\n<!ELEMENT bar ANY>\n<!ATTLIST bar a:attr CDATA #IMPLIED\n              b:attr CDATA #IMPLIED\n              c:attr CDATA #IMPLIED>\n]>\n<foo xmlns:a=\"http://example.org/~wilbur\"\n     xmlns:b=\"http://example.org/&#x7E;wilbur\">\n\n<bar a:attr=\"1\" b:attr=\"2\"/>\n\n</foo>\n\n",
  ),
  (
    "eduni/namespaces/1.0/011.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Namespace equality test: use of entity reference -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xmlns:a CDATA #IMPLIED\n              xmlns:b CDATA #IMPLIED\n              xmlns:c CDATA #IMPLIED>\n<!ELEMENT bar ANY>\n<!ATTLIST bar a:attr CDATA #IMPLIED\n              b:attr CDATA #IMPLIED\n              c:attr CDATA #IMPLIED>\n<!ENTITY tilde \"~\">\n]>\n<foo xmlns:a=\"http://example.org/~wilbur\"\n     xmlns:b=\"http://example.org/&tilde;wilbur\">\n\n<bar a:attr=\"1\" b:attr=\"2\"/>\n\n</foo>\n\n",
  ),
  (
    "eduni/namespaces/1.0/012.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Namespace inequality test: equal after attribute value normalization -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo xmlns:a CDATA #IMPLIED\n              xmlns:b NMTOKEN #IMPLIED\n              xmlns:c CDATA #IMPLIED>\n<!ELEMENT bar ANY>\n<!ATTLIST bar a:attr CDATA #IMPLIED\n              b:attr CDATA #IMPLIED\n              c:attr CDATA #IMPLIED>\n]>\n<foo xmlns:a=\"urn:xyzzy\"\n     xmlns:b=\" urn:xyzzy \">\n\n<bar a:attr=\"1\" b:attr=\"2\"/>\n\n</foo>\n\n",
  ),
  (
    "eduni/namespaces/1.0/013.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Bad QName syntax: multiple colons -->\n<foo>\n<bar a:b:attr=\"1\"/>\n</foo>\n",
  ),
  (
    "eduni/namespaces/1.0/014.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Bad QName syntax: colon at end -->\n<foo: />\n",
  ),
  (
    "eduni/namespaces/1.0/015.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Bad QName syntax: colon at start -->\n<:foo />\n",
  ),
  (
    "eduni/namespaces/1.0/016.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Bad QName syntax: xmlns: -->\n<foo xmlns:=\"http://example.org/namespace\" />\n",
  ),
  (
    "eduni/namespaces/1.0/017.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Simple legal case: no namespaces -->\n<foo/>\n",
  ),
  (
    "eduni/namespaces/1.0/018.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Simple legal case: default namespace -->\n<foo xmlns=\"http://example.org/namespace\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/019.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Simple legal case: prefixed element -->\n<a:foo xmlns:a=\"http://example.org/namespace\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/020.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Simple legal case: prefixed attribute -->\n<foo xmlns:a=\"http://example.org/namespace\" a:attr=\"1\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/021.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Simple legal case: default namespace and unbinding -->\n<foo xmlns=\"http://example.org/namespace\">\n <foo xmlns=\"\"/>\n</foo>\n\n",
  ),
  (
    "eduni/namespaces/1.0/022.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Simple legal case: default namespace and rebinding -->\n<foo xmlns=\"http://example.org/namespace\">\n <foo xmlns=\"http://example.org/other-namespace\"/>\n</foo>\n\n",
  ),
  (
    "eduni/namespaces/1.0/023.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Illegal use of 1.1-style prefix unbinding in 1.0 document -->\n<a:foo xmlns:a=\"http://example.org/namespace\">\n <a:foo xmlns:a=\"\"/>\n</a:foo>\n\n",
  ),
  (
    "eduni/namespaces/1.0/024.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Simple legal case: prefix rebinding -->\n<a:foo xmlns:a=\"http://example.org/namespace\">\n <a:foo xmlns:a=\"http://example.org/other-namespace\"/>\n</a:foo>\n\n",
  ),
  (
    "eduni/namespaces/1.0/025.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Unbound element prefix -->\n<a:foo/>\n",
  ),
  (
    "eduni/namespaces/1.0/026.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Unbound attribute prefix -->\n<foo a:attr=\"1\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/027.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Reserved prefixes and namespaces: using the xml prefix undeclared -->\n<foo xml:lang=\"en\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/028.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Reserved prefixes and namespaces: declaring the xml prefix correctly -->\n<foo xmlns:xml=\"http://www.w3.org/XML/1998/namespace\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/029.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Reserved prefixes and namespaces: declaring the xml prefix incorrectly -->\n<foo xmlns:xml=\"http://example.org/namespace\"/>\n\n",
  ),
  (
    "eduni/namespaces/1.0/030.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Reserved prefixes and namespaces: binding another prefix\n     to the xml namespace -->\n<foo xmlns:yml=\"http://www.w3.org/XML/1998/namespace\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/031.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Reserved prefixes and namespaces: declaring the xmlns prefix\n     with its correct URI (illegal) -->\n<foo xmlns:xmlns=\"http://www.w3.org/2000/xmlns/\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/032.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Reserved prefixes and namespaces: declaring the xmlns prefix\n     with an incorrect URI -->\n<foo xmlns:xmlns=\"http://example.org/namespace\"/>\n\n",
  ),
  (
    "eduni/namespaces/1.0/033.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Reserved prefixes and namespaces: binding another prefix\n     to the xmlns namespace -->\n<foo xmlns:ymlns=\"http://www.w3.org/2000/xmlns/\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/034.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Reserved prefixes and namespaces: binding a reserved prefix -->\n<foo xmlns:xml2=\"http://example.org/namespace\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/035.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Attribute uniqueness: repeated identical attribute -->\n<foo xmlns:a=\"http://example.org/~wilbur\"\n     xmlns:b=\"http://example.org/~wilbur\">\n\n<bar a:attr=\"1\" a:attr=\"2\"/>\n\n</foo>\n",
  ),
  (
    "eduni/namespaces/1.0/036.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Attribute uniqueness: repeated attribute with different prefixes -->\n<foo xmlns:a=\"http://example.org/~wilbur\"\n     xmlns:b=\"http://example.org/~wilbur\">\n\n<bar a:attr=\"1\" b:attr=\"2\"/>\n\n</foo>\n",
  ),
  (
    "eduni/namespaces/1.0/037.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Attribute uniqueness: different attributes with same local name -->\n<foo xmlns:a=\"http://example.org/~wilbur\"\n     xmlns:b=\"http://example.org/~kipper\">\n\n<bar a:attr=\"1\" b:attr=\"2\"/>\n\n</foo>\n",
  ),
  (
    "eduni/namespaces/1.0/038.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Attribute uniqueness: prefixed and unprefixed attributes with same\n     local name -->\n<foo xmlns:a=\"http://example.org/~wilbur\">\n\n<bar a:attr=\"1\" attr=\"2\"/>\n\n</foo>\n",
  ),
  (
    "eduni/namespaces/1.0/039.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Attribute uniqueness: prefixed and unprefixed attributes with same\n     local name, with default namespace -->\n<foo xmlns:a=\"http://example.org/~wilbur\"\n     xmlns:b=\"http://example.org/~kipper\"\n     xmlns=\"http://example.org/~wilbur\">\n\n<b:bar a:attr=\"1\" attr=\"2\"/>\n\n</foo>\n",
  ),
  (
    "eduni/namespaces/1.0/040.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Attribute uniqueness: prefixed and unprefixed attributes with same\n     local name, with default namespace and element in default namespace -->\n<foo xmlns:a=\"http://example.org/~wilbur\"\n     xmlns=\"http://example.org/~wilbur\">\n\n<bar a:attr=\"1\" attr=\"2\"/>\n\n</foo>\n",
  ),
  (
    "eduni/namespaces/1.0/041.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Attribute uniqueness: prefixed and unprefixed attributes with same\n     local name, element in same namespace as prefixed attribute -->\n<foo xmlns:a=\"http://example.org/~wilbur\">\n\n<a:bar a:attr=\"1\" attr=\"2\"/>\n\n</foo>\n",
  ),
  (
    "eduni/namespaces/1.0/042.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Colon in PI name -->\n<?a:b bogus?>\n<foo/>\n",
  ),
  (
    "eduni/namespaces/1.0/043.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Colon in entity name -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ENTITY a:b \"bogus\">\n]>\n<foo/>\n",
  ),
  (
    "eduni/namespaces/1.0/044.xml", "refuse", "<?xml version=\"1.0\"?>\n<!-- Colon in entity name -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!NOTATION a:b SYSTEM \"notation\">\n]>\n<foo/>\n",
  ),
  (
    "eduni/namespaces/1.0/045.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Colon in ID attribute name -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo id ID #REQUIRED>\n]>\n<foo id=\"a:b\"/>\n",
  ),
  (
    "eduni/namespaces/1.0/046.xml", "pass", "<?xml version=\"1.0\"?>\n<!-- Colon in ID attribute name -->\n<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo id  ID #IMPLIED\n              ref IDREF #IMPLIED>\n]>\n<foo ref=\"a:b\">\n <foo id=\"a:b\"/>\n</foo>\n",
  ),
  (
    "eduni/namespaces/1.0/047.xml", "pass", "<!DOCTYPE xml:foo [\n<!ELEMENT xml:foo EMPTY>\n]>\n<xml:foo/>\n",
  ),
  (
    "eduni/namespaces/1.0/048.xml", "pass", "<!DOCTYPE x [\n<!ELEMENT x EMPTY>\n<!ATTLIST x xml:foo CDATA #IMPLIED>\n]>\n<x xml:foo=\"\"/>\n",
  ),
