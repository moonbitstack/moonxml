  (
    "ibm/not-wf/P01/ibm01n01.xml", "refuse", "<?xml version=\"1.0\"?>\r\n<!DOCTYPE book [\r\n   <!ELEMENT book ANY>\r\n]>\r\n<!-- element is missing -->",
  ),
  (
    "ibm/not-wf/P01/ibm01n02.xml", "refuse", "<doc>Wrong ordering between prolog and element!</doc>\r\n<?xml version=\"1.0\"?>\r\n<!DOCTYPE doc [\r\n   <!ELEMENT doc ANY>\r\n]>",
  ),
  (
    "ibm/not-wf/P01/ibm01n03.xml", "refuse", "<?xml version=\"1.0\"?>\r\n<!DOCTYPE doc [\r\n   <!ELEMENT doc ANY>\r\n   <!ELEMENT title ANY>\r\n]>\r\n<doc>Wrong combination!</doc>\r\n<?PI after document element?>\r\n<title>Wrong combination!</title>\r\n<?PI after title element?>\r\n",
