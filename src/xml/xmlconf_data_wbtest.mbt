  (
    "ibm/valid/P32/ibm32v04.xml", "pass", "<?xml version=\"1.0\" standalone=\"no\" ?>\r\n<!DOCTYPE animal SYSTEM \"ibm32v04.dtd\">\r\n<animal>This is a \r\n      <a/>  \r\n\r\nyellow tiger</animal>\r\n<!-- Tests VC: Standalone Document Declaration with whitespace in mixed content -->\r\n",
