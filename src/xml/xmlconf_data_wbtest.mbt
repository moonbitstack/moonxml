  (
    "ibm/not-wf/P82/ibm82n03.xml", "refuse", "<?xml version=\"1.0\"?>\r\n<!DOCTYPE root \r\n[\r\n<!ELEMENT root (#PCDATA)>\r\n<!ATTLIST root att CDATA #IMPLIED>\r\n<!--* Missing ExternalID or PublicID in NotationDecl *-->\r\n<!NOTATION JPGformat >\r\n<!ENTITY aImage SYSTEM \"image.jpg\" NDATA JPGformat>\r\n]>\r\n<root/>\r\n",
