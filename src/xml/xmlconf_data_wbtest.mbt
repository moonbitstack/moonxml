  (
    "ibm/not-wf/P82/ibm82n05.xml", "refuse", "<?xml version=\"1.0\"?>\r\n<!DOCTYPE root \r\n[\r\n<!ELEMENT root (#PCDATA)>\r\n<!ATTLIST root att CDATA #IMPLIED>\r\n<!--* Wrong keyword: notation in NotationDecl *-->\r\n<!notation JPGformat SYSTEM \"JPGFormat\">\r\n<!ENTITY aImage SYSTEM \"image.jpg\" NDATA JPGformat>\r\n]>\r\n<root/>\r\n",
  ),
  (
    "ibm/not-wf/P82/ibm82n06.xml", "refuse", "<?xml version=\"1.0\"?>\r\n<!DOCTYPE root \r\n[\r\n<!ELEMENT root (#PCDATA)>\r\n<!ATTLIST root att CDATA #IMPLIED>\r\n<!--* Missing closing bracket in NotationDecl *-->\r\n<!NOTATION JPGformat PUBLIC \"-//JPG//DTD//JPGFormat\"\r\n<!ENTITY aImage SYSTEM \"image.jpg\" NDATA JPGformat>\r\n]>\r\n<root/>\r\n",
  ),
  (
    "ibm/not-wf/P82/ibm82n07.xml", "refuse", "<?xml version=\"1.0\"?>\r\n<!DOCTYPE root \r\n[\r\n<!ELEMENT root (#PCDATA)>\r\n<!ATTLIST root att CDATA #IMPLIED>\r\n<!--* Wrong beginning sequence in NotationDecl *-->\r\n<NOTATION JPGformat PUBLIC \"-//JPG//DTD//JPGFormat\">\r\n<!ENTITY aImage SYSTEM \"image.jpg\" NDATA JPGformat>\r\n]>\r\n<root/>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n",
  ),
  (
    "ibm/not-wf/P82/ibm82n08.xml", "refuse", "<?xml version=\"1.0\"?>\r\n<!DOCTYPE root \r\n[\r\n<!ELEMENT root (#PCDATA)>\r\n<!ATTLIST root att CDATA #IMPLIED>\r\n<!--* Wrong Closing sequence in NotationDecl *-->\r\n<!NOTATION JPGformat SYSTEM \"JPGFormat\"!>\r\n<!ENTITY aImage SYSTEM \"image.jpg\" NDATA JPGformat>\r\n]>\r\n<root/>\r\n",
  ),
  (
    "ibm/not-wf/P83/ibm83n01.xml", "refuse", "<?xml version=\"1.0\"?>\r\n<!DOCTYPE root \r\n[\r\n<!ELEMENT root (#PCDATA)>\r\n<!ATTLIST root att CDATA #IMPLIED>\r\n<!--* Wrong keyword in PublicID *-->\r\n<!NOTATION JPGformat public \"-//JPG//DTD//JPGFormat\">\r\n<!ENTITY aImage SYSTEM \"image.jpg\" NDATA JPGformat>\r\n]>\r\n<root/>\r\n\r\n",
  ),
  (
    "ibm/not-wf/P83/ibm83n02.xml", "refuse", "r<?xml version=\"1.0\"?>\r\n<!DOCTYPE root \r\n[\r\n<!ELEMENT root (#PCDATA)>\r\n<!ATTLIST root att CDATA #IMPLIED>\r\n<!--* Wrong keyword : Public in PublicID *-->\r\n<!NOTATION JPGformat Public \"-//JPG//DTD//JPGFormat\">\r\n<!ENTITY aImage SYSTEM \"image.jpg\" NDATA JPGformat>\r\n]>\r\n<root/>\r\n",
  ),
  (
    "ibm/not-wf/P83/ibm83n03.xml", "refuse", "<?xml version=\"1.0\"?>\r\n<!DOCTYPE root \r\n[\r\n<!ELEMENT root (#PCDATA)>\r\n<!ATTLIST root att CDATA #IMPLIED>\r\n<!--* Missing keyword in PublicID *-->\r\n<!NOTATION JPGformat \"-//JPG//DTD//JPGFormat\">\r\n<!ENTITY aImage SYSTEM \"image.jpg\" NDATA JPGformat>\r\n]>\r\n<root/>\r\n",
  ),
  (
    "ibm/not-wf/P83/ibm83n04.xml", "refuse", "<?xml version=\"1.0\"?>\r\n<!DOCTYPE root \r\n[\r\n<!ELEMENT root (#PCDATA)>\r\n<!ATTLIST root att CDATA #IMPLIED>\r\n<!--* Missing White space in PublicID *-->\r\n<!NOTATION JPGformat PUBLIC\"-//JPG//DTD//JPGFormat\">\r\n<!ENTITY aImage SYSTEM \"image.jpg\" NDATA JPGformat>\r\n]>\r\n<root/>\r\n",
  ),
  (
    "ibm/not-wf/P83/ibm83n05.xml", "refuse", "<?xml version=\"1.0\"?>\r\n<!DOCTYPE root \r\n[\r\n<!ELEMENT root (#PCDATA)>\r\n<!ATTLIST root att CDATA #IMPLIED>\r\n<!--* Missing PubidLiteral in PublicID *-->\r\n<!NOTATION JPGformat PUBLIC >\r\n<!ENTITY aImage SYSTEM \"image.jpg\" NDATA JPGformat>\r\n]>\r\n<root/>\r\n",
  ),
  (
    "ibm/not-wf/P83/ibm83n06.xml", "refuse", "<?xml version=\"1.0\"?>\r\n<!DOCTYPE root \r\n[\r\n<!ELEMENT root (#PCDATA)>\r\n<!ATTLIST root att CDATA #IMPLIED>\r\n<!--* Wrong ordering in PublicID *-->\r\n<!NOTATION JPGformat \"-//JPG//DTD//JPGFormat\" PUBLIC>\r\n<!ENTITY aImage SYSTEM \"image.jpg\" NDATA JPGformat>\r\n]>\r\n<root/>\r\n",
  ),
  (
    "eduni/errata-2e/E2a.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!ATTLIST foo bar (one|one) #IMPLIED>\n]>\n<foo/>\n\n",
  ),
  (
    "eduni/errata-2e/E2b.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!NOTATION one SYSTEM \"file:///usr/bin/awk\">\n<!ATTLIST foo bar NOTATION (one|one) #IMPLIED>\n]>\n<foo/>\n",
  ),
  (
    "eduni/errata-2e/E9a.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!NOTATION gif SYSTEM \"file:///usr/X11R6/bin/xv\">\n<!ENTITY declared SYSTEM \"xyzzy\" NDATA gif>\n<!ATTLIST foo bar ENTITY \"undeclared\">\n]>\n<foo bar=\"declared\"/>\n",
  ),
  (
    "eduni/errata-2e/E9b.xml", "pass", "<!DOCTYPE foo [\n<!ELEMENT foo ANY>\n<!NOTATION gif SYSTEM \"file:///usr/X11R6/bin/xv\">\n<!ENTITY declared SYSTEM \"xyzzy\" NDATA gif>\n<!ATTLIST foo bar ENTITY \"7\">\n]>\n<foo bar=\"declared\"/>\n",
