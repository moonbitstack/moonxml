    { file: "tricky01.dat", input: "<b><p>Bold </b> Not bold</p>\nAlso not bold.", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     <b>\n|     <p>\n|       <b>\n|         \"Bold \"\n|       \" Not bold\"\n|     \"" },
    { file: "tricky01.dat", input: "<html>\n<font color=red><i>Italic and Red<p>Italic and Red </font> Just italic.</p> Italic only.</i> Plain\n<p>I should not be red. <font color=red>Red. <i>Italic and red.</p>\n<p>Italic and red. </i> Red.</font> I should not be red.</p>\n<b>Bold <i>Bold and italic</b> Only Italic </i> Plain", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     <font>\n|       color=\"red\"\n|       <i>\n|         \"Italic and Red\"\n|     <i>\n|       <p>\n|         <font>\n|           color=\"red\"\n|           \"Italic and Red \"\n|         \" Just italic.\"\n|       \" Italic only.\"\n|     \" Plain" },
    { file: "tricky01.dat", input: "<html><body>\n<p><font size=\"7\">First paragraph.</p>\n<p>Second paragraph.</p></font>\n<b><p><i>Bold and Italic</b> Italic</p>", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     \"" },
    { file: "tricky01.dat", input: "<html>\n<dl>\n<dt><b>Boo\n<dd>Goo?\n</dl>\n</html>", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     <dl>\n|       \"" },
    { file: "tricky01.dat", input: "<html><body>\n<label><a><div>Hello<div>World</div></a></label>  \n</body></html>", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     \"" },
    { file: "tricky01.dat", input: "<table><center> <font>a</center> <img> <tr><td> </td> </tr> </table>", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     <center>\n|       \" \"\n|       <font>\n|         \"a\"\n|     <font>\n|       <img>\n|       \" \"\n|     <table>\n|       \" \"\n|       <tbody>\n|         <tr>\n|           <td>\n|             \" \"\n|           \" \"\n|         \" \"" },
    { file: "tricky01.dat", input: "<table><tr><p><a><p>You should see this text.", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     <p>\n|       <a>\n|     <p>\n|       <a>\n|         \"You should see this text.\"\n|     <table>\n|       <tbody>\n|         <tr>" },
    { file: "tricky01.dat", input: "<TABLE>\n<TR>\n<CENTER><CENTER><TD></TD></TR><TR>\n<FONT>\n<TABLE><tr></tr></TABLE>\n</P>\n<a></font><font></a>\nThis page contains an insanely badly-nested tag sequence.", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     <center>\n|       <center>\n|     <font>\n|       \"" },
    { file: "tricky01.dat", input: "<html>\n<body>\n<b><nobr><div>This text is in a div inside a nobr</nobr>More text that should not be in the nobr, i.e., the\nnobr should have closed the div inside it implicitly. </b><pre>A pre tag outside everything else.</pre>\n</body>\n</html>", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     \"" },
    { file: "webkit01.dat", input: "Test", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     \"Test\"" },
