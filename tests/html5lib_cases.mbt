    { file: "webkit01.dat", input: "<div>Hello</div>\n<script>\nconsole.log(\"PASS\");\n</script>\n<div>Bye</div>", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     <div>\n|       \"Hello\"\n|     \"" },
    { file: "webkit01.dat", input: "<div foo=\"bar\">Hello</div>", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     <div>\n|       foo=\"bar\"\n|       \"Hello\"" },
    { file: "webkit01.dat", input: "<div>Hello</div>\n<script>\nconsole.log(\"FOO<span>BAR</span>BAZ\");\n</script>\n<div>Bye</div>", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     <div>\n|       \"Hello\"\n|     \"" },
    { file: "webkit01.dat", input: "<foo bar=\"baz\"></foo><potato quack=\"duck\"></potato>", fragment: "", doc: "| <html>\n|   <head>\n|   <body>\n|     <foo>\n|       bar=\"baz\"\n|     <potato>\n|       quack=\"duck\"" },
