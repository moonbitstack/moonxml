    { file: "numericEntities.test", desc: "Valid numeric entity character U+80000", input: "&#x80000;", state: "data", last: "", expected: ["c򀀀"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+8FFFD", input: "&#x8fffd;", state: "data", last: "", expected: ["c򏿽"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+90000", input: "&#x90000;", state: "data", last: "", expected: ["c򐀀"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+9FFFD", input: "&#x9fffd;", state: "data", last: "", expected: ["c򟿽"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+A0000", input: "&#xa0000;", state: "data", last: "", expected: ["c򠀀"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+AFFFD", input: "&#xafffd;", state: "data", last: "", expected: ["c򯿽"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+B0000", input: "&#xb0000;", state: "data", last: "", expected: ["c򰀀"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+BFFFD", input: "&#xbfffd;", state: "data", last: "", expected: ["c򿿽"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+C0000", input: "&#xc0000;", state: "data", last: "", expected: ["c󀀀"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+CFFFD", input: "&#xcfffd;", state: "data", last: "", expected: ["c󏿽"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+D0000", input: "&#xd0000;", state: "data", last: "", expected: ["c󐀀"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+DFFFD", input: "&#xdfffd;", state: "data", last: "", expected: ["c󟿽"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+E0000", input: "&#xe0000;", state: "data", last: "", expected: ["c󠀀"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+EFFFD", input: "&#xefffd;", state: "data", last: "", expected: ["c󯿽"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+F0000", input: "&#xf0000;", state: "data", last: "", expected: ["c󰀀"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+FFFFD", input: "&#xffffd;", state: "data", last: "", expected: ["c󿿽"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+100000", input: "&#x100000;", state: "data", last: "", expected: ["c􀀀"] },
    { file: "numericEntities.test", desc: "Valid numeric entity character U+10FFFD", input: "&#x10fffd;", state: "data", last: "", expected: ["c􏿽"] },
    { file: "pendingSpecChanges.test", desc: "<!---- >", input: "<!---- >", state: "data", last: "", expected: ["m-- >"] },
    { file: "test1.test", desc: "Correct Doctype lowercase", input: "<!DOCTYPE html>", state: "data", last: "", expected: ["d=html\u{1F}~\u{1F}~\u{1F}1"] },
    { file: "test1.test", desc: "Correct Doctype uppercase", input: "<!DOCTYPE HTML>", state: "data", last: "", expected: ["d=html\u{1F}~\u{1F}~\u{1F}1"] },
    { file: "test1.test", desc: "Correct Doctype mixed case", input: "<!DOCTYPE HtMl>", state: "data", last: "", expected: ["d=html\u{1F}~\u{1F}~\u{1F}1"] },
    { file: "test1.test", desc: "Correct Doctype case with EOF", input: "<!DOCTYPE HtMl", state: "data", last: "", expected: ["d=html\u{1F}~\u{1F}~\u{1F}0"] },
    { file: "test1.test", desc: "Truncated doctype start", input: "<!DOC>", state: "data", last: "", expected: ["mDOC"] },
    { file: "test1.test", desc: "Doctype in error", input: "<!DOCTYPE foo>", state: "data", last: "", expected: ["d=foo\u{1F}~\u{1F}~\u{1F}1"] },
    { file: "test1.test", desc: "Single Start Tag", input: "<h>", state: "data", last: "", expected: ["sh"] },
    { file: "test1.test", desc: "Empty end tag", input: "</>", state: "data", last: "", expected: [] },
    { file: "test1.test", desc: "Empty start tag", input: "<>", state: "data", last: "", expected: ["c<>"] },
    { file: "test1.test", desc: "Start Tag w/attribute", input: "<h a='b'>", state: "data", last: "", expected: ["sh\u{1F}a=b"] },
    { file: "test1.test", desc: "Start Tag w/attribute no quotes", input: "<h a=b>", state: "data", last: "", expected: ["sh\u{1F}a=b"] },
    { file: "test1.test", desc: "Start/End Tag", input: "<h></h>", state: "data", last: "", expected: ["sh", "eh"] },
    { file: "test1.test", desc: "Two unclosed start tags", input: "<p>One<p>Two", state: "data", last: "", expected: ["sp", "cOne", "sp", "cTwo"] },
    { file: "test1.test", desc: "End Tag w/attribute", input: "<h></h a='b'>", state: "data", last: "", expected: ["sh", "eh"] },
    { file: "test1.test", desc: "Multiple atts", input: "<h a='b' c='d'>", state: "data", last: "", expected: ["sh\u{1F}a=b\u{1F}c=d"] },
    { file: "test1.test", desc: "Multiple atts no space", input: "<h a='b'c='d'>", state: "data", last: "", expected: ["sh\u{1F}a=b\u{1F}c=d"] },
    { file: "test1.test", desc: "Repeated attr", input: "<h a='b' a='d'>", state: "data", last: "", expected: ["sh\u{1F}a=b"] },
    { file: "test1.test", desc: "Simple comment", input: "<!--comment-->", state: "data", last: "", expected: ["mcomment"] },
    { file: "test1.test", desc: "Comment, Central dash no space", input: "<!----->", state: "data", last: "", expected: ["m-"] },
    { file: "test1.test", desc: "Comment, two central dashes", input: "<!-- --comment -->", state: "data", last: "", expected: ["m --comment "] },
    { file: "test1.test", desc: "Comment, central less-than bang", input: "<!--<!-->", state: "data", last: "", expected: ["m<!"] },
    { file: "test1.test", desc: "Unfinished comment", input: "<!--comment", state: "data", last: "", expected: ["mcomment"] },
    { file: "test1.test", desc: "Unfinished comment after start of nested comment", input: "<!-- <!--", state: "data", last: "", expected: ["m <!"] },
    { file: "test1.test", desc: "Start of a comment", input: "<!-", state: "data", last: "", expected: ["m-"] },
    { file: "test1.test", desc: "Short comment", input: "<!-->", state: "data", last: "", expected: ["m"] },
    { file: "test1.test", desc: "Short comment two", input: "<!--->", state: "data", last: "", expected: ["m"] },
    { file: "test1.test", desc: "Short comment three", input: "<!---->", state: "data", last: "", expected: ["m"] },
    { file: "test1.test", desc: "< in comment", input: "<!-- <test-->", state: "data", last: "", expected: ["m <test"] },
    { file: "test1.test", desc: "<< in comment", input: "<!--<<-->", state: "data", last: "", expected: ["m<<"] },
    { file: "test1.test", desc: "<! in comment", input: "<!-- <!test-->", state: "data", last: "", expected: ["m <!test"] },
    { file: "test1.test", desc: "<!- in comment", input: "<!-- <!-test-->", state: "data", last: "", expected: ["m <!-test"] },
    { file: "test1.test", desc: "Nested comment", input: "<!-- <!--test-->", state: "data", last: "", expected: ["m <!--test"] },
    { file: "test1.test", desc: "Nested comment with extra <", input: "<!-- <<!--test-->", state: "data", last: "", expected: ["m <<!--test"] },
    { file: "test1.test", desc: "< in script data", input: "<test-->", state: "script", last: "", expected: ["c<test-->"] },
    { file: "test1.test", desc: "<! in script data", input: "<!test-->", state: "script", last: "", expected: ["c<!test-->"] },
    { file: "test1.test", desc: "<!- in script data", input: "<!-test-->", state: "script", last: "", expected: ["c<!-test-->"] },
    { file: "test1.test", desc: "Escaped script data", input: "<!--test-->", state: "script", last: "", expected: ["c<!--test-->"] },
    { file: "test1.test", desc: "< in script HTML comment", input: "<!-- < test -->", state: "script", last: "", expected: ["c<!-- < test -->"] },
    { file: "test1.test", desc: "</ in script HTML comment", input: "<!-- </ test -->", state: "script", last: "", expected: ["c<!-- </ test -->"] },
    { file: "test1.test", desc: "Start tag in script HTML comment", input: "<!-- <test> -->", state: "script", last: "", expected: ["c<!-- <test> -->"] },
    { file: "test1.test", desc: "End tag in script HTML comment", input: "<!-- </test> -->", state: "script", last: "", expected: ["c<!-- </test> -->"] },
    { file: "test1.test", desc: "- in script HTML comment double escaped", input: "<!--<script>-</script>-->", state: "script", last: "", expected: ["c<!--<script>-</script>-->"] },
    { file: "test1.test", desc: "-- in script HTML comment double escaped", input: "<!--<script>--</script>-->", state: "script", last: "", expected: ["c<!--<script>--</script>-->"] },
    { file: "test1.test", desc: "--- in script HTML comment double escaped", input: "<!--<script>---</script>-->", state: "script", last: "", expected: ["c<!--<script>---</script>-->"] },
    { file: "test1.test", desc: "- spaced in script HTML comment double escaped", input: "<!--<script> - </script>-->", state: "script", last: "", expected: ["c<!--<script> - </script>-->"] },
    { file: "test1.test", desc: "-- spaced in script HTML comment double escaped", input: "<!--<script> -- </script>-->", state: "script", last: "", expected: ["c<!--<script> -- </script>-->"] },
    { file: "test1.test", desc: "Ampersand EOF", input: "&", state: "data", last: "", expected: ["c&"] },
    { file: "test1.test", desc: "Ampersand ampersand EOF", input: "&&", state: "data", last: "", expected: ["c&&"] },
    { file: "test1.test", desc: "Ampersand space EOF", input: "& ", state: "data", last: "", expected: ["c& "] },
    { file: "test1.test", desc: "Unfinished entity", input: "&f", state: "data", last: "", expected: ["c&f"] },
    { file: "test1.test", desc: "Ampersand, number sign", input: "&#", state: "data", last: "", expected: ["c&#"] },
    { file: "test1.test", desc: "Unfinished numeric entity", input: "&#x", state: "data", last: "", expected: ["c&#x"] },
    { file: "test1.test", desc: "Entity with trailing semicolon (1)", input: "I'm &not;it", state: "data", last: "", expected: ["cI'm ¬it"] },
    { file: "test1.test", desc: "Entity with trailing semicolon (2)", input: "I'm &notin;", state: "data", last: "", expected: ["cI'm ∉"] },
    { file: "test1.test", desc: "Entity without trailing semicolon (1)", input: "I'm &notit", state: "data", last: "", expected: ["cI'm ¬it"] },
    { file: "test1.test", desc: "Entity without trailing semicolon (2)", input: "I'm &notin", state: "data", last: "", expected: ["cI'm ¬in"] },
    { file: "test1.test", desc: "Partial entity match at end of file", input: "I'm &no", state: "data", last: "", expected: ["cI'm &no"] },
    { file: "test1.test", desc: "Non-ASCII character reference name", input: "&¬;", state: "data", last: "", expected: ["c&¬;"] },
    { file: "test1.test", desc: "ASCII decimal entity", input: "&#0036;", state: "data", last: "", expected: ["c$"] },
    { file: "test1.test", desc: "ASCII hexadecimal entity", input: "&#x3f;", state: "data", last: "", expected: ["c?"] },
    { file: "test1.test", desc: "Hexadecimal entity in attribute", input: "<h a='&#x3f;'></h>", state: "data", last: "", expected: ["sh\u{1F}a=?", "eh"] },
    { file: "test1.test", desc: "Entity in attribute without semicolon ending in x", input: "<h a='&notx'>", state: "data", last: "", expected: ["sh\u{1F}a=&notx"] },
    { file: "test1.test", desc: "Entity in attribute without semicolon ending in 1", input: "<h a='&not1'>", state: "data", last: "", expected: ["sh\u{1F}a=&not1"] },
    { file: "test1.test", desc: "Entity in attribute without semicolon ending in i", input: "<h a='&noti'>", state: "data", last: "", expected: ["sh\u{1F}a=&noti"] },
    { file: "test1.test", desc: "Entity in attribute without semicolon", input: "<h a='&COPY'>", state: "data", last: "", expected: ["sh\u{1F}a=©"] },
    { file: "test1.test", desc: "Unquoted attribute ending in ampersand", input: "<s o=& t>", state: "data", last: "", expected: ["ss\u{1F}o=&\u{1F}t="] },
    { file: "test1.test", desc: "Unquoted attribute at end of tag with final character of &, with tag followed by characters", input: "<a a=a&>foo", state: "data", last: "", expected: ["sa\u{1F}a=a&", "cfoo"] },
    { file: "test1.test", desc: "plaintext element", input: "<plaintext>foobar", state: "data", last: "", expected: ["splaintext", "cfoobar"] },
    { file: "test1.test", desc: "Open angled bracket in unquoted attribute value state", input: "<a a=f<>", state: "data", last: "", expected: ["sa\u{1F}a=f<"] },
    { file: "test2.test", desc: "DOCTYPE without name", input: "<!DOCTYPE>", state: "data", last: "", expected: ["d~\u{1F}~\u{1F}~\u{1F}0"] },
    { file: "test2.test", desc: "DOCTYPE without space before name", input: "<!DOCTYPEhtml>", state: "data", last: "", expected: ["d=html\u{1F}~\u{1F}~\u{1F}1"] },
    { file: "test2.test", desc: "Incorrect DOCTYPE without a space before name", input: "<!DOCTYPEfoo>", state: "data", last: "", expected: ["d=foo\u{1F}~\u{1F}~\u{1F}1"] },
    { file: "test2.test", desc: "DOCTYPE with publicId", input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML Transitional 4.01//EN\">", state: "data", last: "", expected: ["d=html\u{1F}=-//W3C//DTD HTML Transitional 4.01//EN\u{1F}~\u{1F}1"] },
    { file: "test2.test", desc: "DOCTYPE with EOF after PUBLIC", input: "<!DOCTYPE html PUBLIC", state: "data", last: "", expected: ["d=html\u{1F}~\u{1F}~\u{1F}0"] },
    { file: "test2.test", desc: "DOCTYPE with EOF after PUBLIC '", input: "<!DOCTYPE html PUBLIC '", state: "data", last: "", expected: ["d=html\u{1F}=\u{1F}~\u{1F}0"] },
    { file: "test2.test", desc: "DOCTYPE with EOF after PUBLIC 'x", input: "<!DOCTYPE html PUBLIC 'x", state: "data", last: "", expected: ["d=html\u{1F}=x\u{1F}~\u{1F}0"] },
    { file: "test2.test", desc: "DOCTYPE with systemId", input: "<!DOCTYPE html SYSTEM \"-//W3C//DTD HTML Transitional 4.01//EN\">", state: "data", last: "", expected: ["d=html\u{1F}~\u{1F}=-//W3C//DTD HTML Transitional 4.01//EN\u{1F}1"] },
    { file: "test2.test", desc: "DOCTYPE with single-quoted systemId", input: "<!DOCTYPE html SYSTEM '-//W3C//DTD HTML Transitional 4.01//EN'>", state: "data", last: "", expected: ["d=html\u{1F}~\u{1F}=-//W3C//DTD HTML Transitional 4.01//EN\u{1F}1"] },
    { file: "test2.test", desc: "DOCTYPE with publicId and systemId", input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML Transitional 4.01//EN\" \"-//W3C//DTD HTML Transitional 4.01//EN\">", state: "data", last: "", expected: ["d=html\u{1F}=-//W3C//DTD HTML Transitional 4.01//EN\u{1F}=-//W3C//DTD HTML Transitional 4.01//EN\u{1F}1"] },
    { file: "test2.test", desc: "DOCTYPE with > in double-quoted publicId", input: "<!DOCTYPE html PUBLIC \">x", state: "data", last: "", expected: ["d=html\u{1F}=\u{1F}~\u{1F}0", "cx"] },
    { file: "test2.test", desc: "DOCTYPE with > in single-quoted publicId", input: "<!DOCTYPE html PUBLIC '>x", state: "data", last: "", expected: ["d=html\u{1F}=\u{1F}~\u{1F}0", "cx"] },
    { file: "test2.test", desc: "DOCTYPE with > in double-quoted systemId", input: "<!DOCTYPE html PUBLIC \"foo\" \">x", state: "data", last: "", expected: ["d=html\u{1F}=foo\u{1F}=\u{1F}0", "cx"] },
    { file: "test2.test", desc: "DOCTYPE with > in single-quoted systemId", input: "<!DOCTYPE html PUBLIC 'foo' '>x", state: "data", last: "", expected: ["d=html\u{1F}=foo\u{1F}=\u{1F}0", "cx"] },
    { file: "test2.test", desc: "Incomplete doctype", input: "<!DOCTYPE html ", state: "data", last: "", expected: ["d=html\u{1F}~\u{1F}~\u{1F}0"] },
    { file: "test2.test", desc: "Numeric entity representing the NUL character", input: "&#0000;", state: "data", last: "", expected: ["c�"] },
    { file: "test2.test", desc: "Hexadecimal entity representing the NUL character", input: "&#x0000;", state: "data", last: "", expected: ["c�"] },
    { file: "test2.test", desc: "Numeric entity representing a codepoint after 1114111 (U+10FFFF)", input: "&#2225222;", state: "data", last: "", expected: ["c�"] },
    { file: "test2.test", desc: "Hexadecimal entity representing a codepoint after 1114111 (U+10FFFF)", input: "&#x1010FFFF;", state: "data", last: "", expected: ["c�"] },
    { file: "test2.test", desc: "Hexadecimal entity pair representing a surrogate pair", input: "&#xD869;&#xDED6;", state: "data", last: "", expected: ["c��"] },
    { file: "test2.test", desc: "Hexadecimal entity with mixed uppercase and lowercase", input: "&#xaBcD;", state: "data", last: "", expected: ["cꯍ"] },
    { file: "test2.test", desc: "Entity without a name", input: "&;", state: "data", last: "", expected: ["c&;"] },
    { file: "test2.test", desc: "Unescaped ampersand in attribute value", input: "<h a='&'>", state: "data", last: "", expected: ["sh\u{1F}a=&"] },
    { file: "test2.test", desc: "StartTag containing <", input: "<a<b>", state: "data", last: "", expected: ["sa<b"] },
    { file: "test2.test", desc: "Non-void element containing trailing /", input: "<h/>", state: "data", last: "", expected: ["sh\u{1F}/"] },
    { file: "test2.test", desc: "Void element with permitted slash", input: "<br/>", state: "data", last: "", expected: ["sbr\u{1F}/"] },
    { file: "test2.test", desc: "Void element with permitted slash (with attribute)", input: "<br foo='bar'/>", state: "data", last: "", expected: ["sbr\u{1F}foo=bar\u{1F}/"] },
    { file: "test2.test", desc: "StartTag containing /", input: "<h/a='b'>", state: "data", last: "", expected: ["sh\u{1F}a=b"] },
    { file: "test2.test", desc: "Double-quoted attribute value", input: "<h a=\"b\">", state: "data", last: "", expected: ["sh\u{1F}a=b"] },
    { file: "test2.test", desc: "Unescaped </", input: "</", state: "data", last: "", expected: ["c</"] },
    { file: "test2.test", desc: "Illegal end tag name", input: "</1>", state: "data", last: "", expected: ["m1"] },
    { file: "test2.test", desc: "Unescaped <", input: "foo < bar", state: "data", last: "", expected: ["cfoo < bar"] },
    { file: "test2.test", desc: "Null Byte Replacement", input: "\u{0}", state: "data", last: "", expected: ["c\\u{0}"] },
    { file: "test2.test", desc: "Comment with dash", input: "<!---x", state: "data", last: "", expected: ["m-x"] },
    { file: "test2.test", desc: "Entity + newline", input: "\nx\n&gt;\n", state: "data", last: "", expected: ["c\\nx\\n>\\n"] },
    { file: "test2.test", desc: "Start tag with no attributes but space before the greater-than sign", input: "<h >", state: "data", last: "", expected: ["sh"] },
    { file: "test2.test", desc: "Empty attribute followed by uppercase attribute", input: "<h a B=''>", state: "data", last: "", expected: ["sh\u{1F}a=\u{1F}b="] },
    { file: "test2.test", desc: "Double-quote after attribute name", input: "<h a \">", state: "data", last: "", expected: ["sh\u{1F}a=\u{1F}\"="] },
    { file: "test2.test", desc: "Single-quote after attribute name", input: "<h a '>", state: "data", last: "", expected: ["sh\u{1F}a=\u{1F}'="] },
    { file: "test2.test", desc: "Empty end tag with following characters", input: "a</>bc", state: "data", last: "", expected: ["cabc"] },
    { file: "test2.test", desc: "Empty end tag with following tag", input: "a</><b>c", state: "data", last: "", expected: ["ca", "sb", "cc"] },
    { file: "test2.test", desc: "Empty end tag with following comment", input: "a</><!--b-->c", state: "data", last: "", expected: ["ca", "mb", "cc"] },
    { file: "test2.test", desc: "Empty end tag with following end tag", input: "a</></b>c", state: "data", last: "", expected: ["ca", "eb", "cc"] },
    { file: "test3.test", desc: "[empty]", input: "", state: "data", last: "", expected: [] },
    { file: "test3.test", desc: "[empty]", input: "", state: "plaintext", last: "", expected: [] },
    { file: "test3.test", desc: "[empty]", input: "", state: "rcdata", last: "", expected: [] },
    { file: "test3.test", desc: "[empty]", input: "", state: "rawtext", last: "", expected: [] },
    { file: "test3.test", desc: "[empty]", input: "", state: "script", last: "", expected: [] },
    { file: "test3.test", desc: "[empty]", input: "", state: "cdata", last: "", expected: [] },
    { file: "test3.test", desc: "\\u0009", input: "\t", state: "data", last: "", expected: ["c\\t"] },
    { file: "test3.test", desc: "\\u0009", input: "\t", state: "plaintext", last: "", expected: ["c\\t"] },
    { file: "test3.test", desc: "\\u0009", input: "\t", state: "rcdata", last: "", expected: ["c\\t"] },
    { file: "test3.test", desc: "\\u0009", input: "\t", state: "rawtext", last: "", expected: ["c\\t"] },
    { file: "test3.test", desc: "\\u0009", input: "\t", state: "script", last: "", expected: ["c\\t"] },
    { file: "test3.test", desc: "\\u0009", input: "\t", state: "cdata", last: "", expected: ["c\\t"] },
    { file: "test3.test", desc: "\\u000A", input: "\n", state: "data", last: "", expected: ["c\\n"] },
    { file: "test3.test", desc: "\\u000A", input: "\n", state: "plaintext", last: "", expected: ["c\\n"] },
    { file: "test3.test", desc: "\\u000A", input: "\n", state: "rcdata", last: "", expected: ["c\\n"] },
    { file: "test3.test", desc: "\\u000A", input: "\n", state: "rawtext", last: "", expected: ["c\\n"] },
    { file: "test3.test", desc: "\\u000A", input: "\n", state: "script", last: "", expected: ["c\\n"] },
    { file: "test3.test", desc: "\\u000A", input: "\n", state: "cdata", last: "", expected: ["c\\n"] },
    { file: "test3.test", desc: "\\u000B", input: "\u{B}", state: "data", last: "", expected: ["c\\u{B}"] },
    { file: "test3.test", desc: "\\u000B", input: "\u{B}", state: "plaintext", last: "", expected: ["c\\u{B}"] },
    { file: "test3.test", desc: "\\u000B", input: "\u{B}", state: "rcdata", last: "", expected: ["c\\u{B}"] },
    { file: "test3.test", desc: "\\u000B", input: "\u{B}", state: "rawtext", last: "", expected: ["c\\u{B}"] },
    { file: "test3.test", desc: "\\u000B", input: "\u{B}", state: "script", last: "", expected: ["c\\u{B}"] },
    { file: "test3.test", desc: "\\u000B", input: "\u{B}", state: "cdata", last: "", expected: ["c\\u{B}"] },
