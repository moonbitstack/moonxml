  "css-selectors",
  "css3",
  "css4",
  "selector",
  "dom",
  "tree",
  "parser",
  "tokenizer",
  "serializer",
  "writer",
  "namespace",
  "cdata",
  "doctype",
  "fragment",
  "template",
  "streaming",
  "event",
  "sink",
  "sax",
  "htmx",
  "query",
  "traversal",
  "edit",
  "scraping",
  "moonbit",
]

description = "HTML, XML and SVG for MoonBit: parse, query and edit."

source = "src"
